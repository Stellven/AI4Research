#!/usr/bin/env bash
set -e

SOLAR_HOME="${SOLAR_HOME:-$HOME/.solar}"
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
RECEIPT_PATH="$SOLAR_HOME/install-receipt.json"

usage() {
    cat <<'EOF'
solar - OpenSolar lifecycle command

Usage:
  solar doctor [--json]
  solar uninstall [--yes] [--keep-data] [--dry-run]
  solar components list
EOF
}

doctor_json() {
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" python3 - <<'PY'
import json
import os
from datetime import datetime, timezone

solar_home = os.environ["SOLAR_HOME"]
claude_dir = os.environ["CLAUDE_DIR"]
receipt_path = os.environ["RECEIPT_PATH"]
result = {
    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "verdict": "ok",
    "components": [],
    "paths": {},
    "warnings": [],
}
if os.path.isfile(receipt_path):
    with open(receipt_path, encoding="utf-8") as f:
        receipt = json.load(f)
    result["components"] = receipt.get("components", [])
else:
    result["verdict"] = "fail"
    result["warnings"].append("install receipt missing")

checks = {
    "solar_home": solar_home,
    "receipt": receipt_path,
    "claude_dir": claude_dir,
    "kernel": os.path.join(claude_dir, "solar", "SOLAR.md"),
    "db": os.path.join(solar_home, "db", "solar.db"),
    "solar_bin": os.path.join(solar_home, "bin", "solar"),
}
for key, path in checks.items():
    ok = os.path.isdir(path) if key in ("solar_home", "claude_dir") else os.path.exists(path)
    result["paths"][key] = "ok" if ok else "missing"
    if not ok and key in ("solar_home", "receipt", "kernel", "solar_bin"):
        result["verdict"] = "fail"
        result["warnings"].append("path missing: " + key)

print(json.dumps(result, indent=2, sort_keys=True))
PY
}

doctor() {
    if [ "${1:-}" = "--json" ]; then
        doctor_json
    else
        doctor_json
    fi
}

remove_sentinel() {
    [ -f "$CLAUDE_DIR/CLAUDE.md" ] || return 0
    python3 - "$CLAUDE_DIR/CLAUDE.md" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
begin = "<!-- BEGIN OPENSOLAR -->"
end = "<!-- END OPENSOLAR -->"
text = path.read_text(encoding="utf-8")
if begin in text and end in text:
    before = text.split(begin, 1)[0].rstrip()
    after = text.split(end, 1)[1].lstrip()
    new = (before + "\n\n" if before else "") + after
    path.write_text(new, encoding="utf-8")
PY
    if [ ! -s "$CLAUDE_DIR/CLAUDE.md" ]; then
        rm -f "$CLAUDE_DIR/CLAUDE.md"
    fi
}

remove_installed_skills() {
    manifest="$CLAUDE_DIR/solar/installed-skills.txt"
    [ -f "$manifest" ] || return 0
    while IFS= read -r skill_name; do
        case "$skill_name" in
            ""|.*|*/*) continue ;;
        esac
        skill_path="$CLAUDE_DIR/skills/$skill_name"
        if guard_path "$skill_path"; then
            rm -rf "$skill_path"
        fi
    done < "$manifest"
    rmdir "$CLAUDE_DIR/skills" 2>/dev/null || true
}

guard_path() {
    [ -n "$1" ] || return 1
    [ "$1" != "/" ] || return 1
    return 0
}

uninstall() {
    yes=false
    keep_data=false
    dry_run=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) yes=true; shift ;;
            --keep-data) keep_data=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) echo "unknown uninstall option: $1" >&2; exit 2 ;;
        esac
    done

    if [ "$yes" != "true" ]; then
        echo "Refusing to uninstall without --yes." >&2
        exit 2
    fi
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "No install receipt found at $RECEIPT_PATH" >&2
        exit 1
    fi
    if [ "$dry_run" = "true" ]; then
        echo "Would remove OpenSolar files recorded under $SOLAR_HOME and $CLAUDE_DIR/solar"
        exit 0
    fi

    remove_sentinel
    remove_installed_skills
    if guard_path "$CLAUDE_DIR/solar"; then
        rm -rf "$CLAUDE_DIR/solar"
    fi
    rmdir "$CLAUDE_DIR" 2>/dev/null || true
    if [ "$keep_data" = "true" ]; then
        rm -rf "$SOLAR_HOME/bin" "$SOLAR_HOME/harness" "$SOLAR_HOME/core" "$SOLAR_HOME/codex-bridge"
        rm -f "$RECEIPT_PATH"
    elif guard_path "$SOLAR_HOME"; then
        rm -rf "$SOLAR_HOME"
    fi
    echo "OpenSolar uninstalled"
}

components_list() {
    if [ -f "$RECEIPT_PATH" ]; then
        python3 - "$RECEIPT_PATH" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as f:
    receipt = json.load(f)
for name in receipt.get("components", []):
    print(name)
PY
    fi
}

cmd="${1:-}"
case "$cmd" in
    doctor) shift; doctor "$@" ;;
    uninstall) shift; uninstall "$@" ;;
    components)
        shift
        [ "${1:-}" = "list" ] || { usage; exit 2; }
        components_list
        ;;
    ""|--help|-h) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
