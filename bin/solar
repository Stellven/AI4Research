#!/usr/bin/env bash
set -e

SOLAR_HOME="${SOLAR_HOME:-$HOME/.solar}"
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
RECEIPT_PATH="$SOLAR_HOME/install-receipt.json"

usage() {
    cat <<'EOF'
solar - OpenSolar lifecycle command

Usage:
  solar version [--json]
  solar doctor [--json]
  solar update [extra install flags]
  solar repair [extra install flags]
  solar backup [--out FILE]
  solar restore <archive>
  solar ui [--once] [--watch N] [--no-color]
  solar uninstall [--yes] [--keep-data] [--dry-run]
  solar components list
EOF
}

receipt_field() {
    [ -f "$RECEIPT_PATH" ] || return 1
    RECEIPT_PATH="$RECEIPT_PATH" python3 - "$1" <<'PY'
import json
import os
import sys

with open(os.environ["RECEIPT_PATH"], encoding="utf-8") as f:
    receipt = json.load(f)
value = receipt.get(sys.argv[1], "")
if isinstance(value, list):
    print(",".join(value))
else:
    print(value)
PY
}

# Data paths under SOLAR_HOME that backup/restore and --keep-data treat as
# user data (config + secrets + receipt + database).
SOLAR_DATA_PATHS="install-receipt.json config.env .env db"

do_version() {
    json=false
    [ "${1:-}" = "--json" ] && json=true
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    ver="$(receipt_field version)"; [ -n "$ver" ] || ver="unknown"
    sha="$(receipt_field git_sha)"
    chan="$(receipt_field channel)"
    repo="$(receipt_field repo)"
    if [ "$json" = "true" ]; then
        RV="$ver" RS="$sha" RC="$chan" RR="$repo" python3 - <<'PY'
import json
import os

print(json.dumps({
    "version": os.environ.get("RV", ""),
    "git_sha": os.environ.get("RS", ""),
    "channel": os.environ.get("RC", ""),
    "repo": os.environ.get("RR", ""),
}, indent=2, sort_keys=True))
PY
    else
        printf 'OpenSolar %s' "$ver"
        if [ -n "$sha" ] && [ "$sha" != "unknown" ]; then
            printf ' (git %s)' "$sha"
        fi
        printf '\n'
        [ -n "$chan" ] && printf 'channel: %s\n' "$chan"
    fi
}

do_backup() {
    out=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --out) out="$2"; shift 2 ;;
            *) echo "unknown backup option: $1" >&2; exit 2 ;;
        esac
    done
    [ -d "$SOLAR_HOME" ] || { echo "no Solar home at $SOLAR_HOME" >&2; exit 1; }
    set --
    for p in $SOLAR_DATA_PATHS; do
        [ -e "$SOLAR_HOME/$p" ] && set -- "$@" "$p"
    done
    [ "$#" -gt 0 ] || { echo "nothing to back up in $SOLAR_HOME" >&2; exit 1; }
    if [ -z "$out" ]; then
        mkdir -p "$SOLAR_HOME/backups"
        out="$SOLAR_HOME/backups/solar-backup-$(date -u +%Y%m%d%H%M%S).tar.gz"
    fi
    tar czf "$out" -C "$SOLAR_HOME" "$@"
    echo "backup written: $out"
}

do_restore() {
    archive="${1:-}"
    [ -n "$archive" ] || { echo "usage: solar restore <archive>" >&2; exit 2; }
    [ -f "$archive" ] || { echo "archive not found: $archive" >&2; exit 1; }
    mkdir -p "$SOLAR_HOME"
    tar xzf "$archive" -C "$SOLAR_HOME"
    echo "restored from $archive into $SOLAR_HOME"
}

# Reinstall in place from the source checkout the receipt recorded -- no fetch.
# Useful when an install is locally damaged; this is the old `update` behavior,
# which never actually fetched anything, kept under an honest name.
do_repair() {
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    src="$(receipt_field source_dir)"
    comps="$(receipt_field components)"
    [ -n "$src" ] || { echo "receipt has no source_dir" >&2; exit 1; }
    [ -n "$comps" ] || { echo "receipt has no components" >&2; exit 1; }
    if [ ! -f "$src/install.sh" ]; then
        echo "installer not found at $src/install.sh; re-clone the source (or run solar update) to repair" >&2
        exit 1
    fi
    echo "repairing from $src (components: $comps)"
    "$src/install.sh" --yes --components "$comps" \
        --solar-home "$SOLAR_HOME" --claude-dir "$CLAUDE_DIR" "$@"
}

# Clone <repo>@<channel> into <dest> (shallow), with one retry. Mirrors
# get-solar.sh fetch_source. Returns nonzero if both attempts fail.
fetch_channel() {
    _repo="$1"; _channel="$2"; _dest="$3"
    rm -rf "$_dest"
    mkdir -p "$(dirname "$_dest")"
    if git clone --depth 1 --branch "$_channel" "$_repo" "$_dest" >/dev/null 2>&1; then
        return 0
    fi
    rm -rf "$_dest"
    git clone --depth 1 --branch "$_channel" "$_repo" "$_dest" >/dev/null 2>&1
}

# Real update: fetch the recorded channel, compare against the installed sha,
# and either report up-to-date or reinstall from the fetched source (which runs
# db_init + migrations + rewrites the receipt), then gate on doctor.
do_update() {
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    comps="$(receipt_field components)"
    repo="$(receipt_field repo)"
    channel="$(receipt_field channel)"
    cur_sha="$(receipt_field git_sha)"
    [ -n "$comps" ] || { echo "receipt has no components" >&2; exit 1; }
    # Pre-channel receipts fall back to the published defaults (kept in sync
    # with get-solar.sh and receipt.sh).
    [ -n "$repo" ] || repo="https://github.com/suraj-subrahmanyan/OpenSolar.git"
    [ -n "$channel" ] || channel="stable"

    command -v git >/dev/null 2>&1 || {
        echo "git is required for solar update; install git, or use solar repair to reinstall in place" >&2
        exit 1
    }

    fetch_dir="${SOLAR_SRC:-$HOME/.solar-src/OpenSolar}"
    tmp_fetch="$fetch_dir.update.$$"
    echo "fetching $repo (channel: $channel)" >&2
    if ! fetch_channel "$repo" "$channel" "$tmp_fetch"; then
        rm -rf "$tmp_fetch"
        echo "update failed: could not fetch channel '$channel' from $repo" >&2
        echo "  check the network and channel, or run solar repair to reinstall from the recorded source." >&2
        exit 1
    fi
    if [ ! -f "$tmp_fetch/install.sh" ]; then
        rm -rf "$tmp_fetch"
        echo "update failed: install.sh not found in the fetched channel ($channel)" >&2
        exit 1
    fi
    new_sha="$(git -C "$tmp_fetch" rev-parse --short HEAD 2>/dev/null || echo unknown)"

    if [ -n "$cur_sha" ] && [ "$cur_sha" != "unknown" ] && [ "$new_sha" = "$cur_sha" ]; then
        echo "already up to date ($cur_sha on $channel)"
        rm -rf "$tmp_fetch"
        return 0
    fi

    echo "updating $cur_sha -> $new_sha (channel: $channel, components: $comps)" >&2
    # Promote the fetch to the canonical source dir so future update/repair find
    # it, then reinstall from it.
    rm -rf "$fetch_dir"
    mkdir -p "$(dirname "$fetch_dir")"
    mv "$tmp_fetch" "$fetch_dir"
    SOLAR_REPO="$repo" SOLAR_CHANNEL="$channel" \
        "$fetch_dir/install.sh" --yes --components "$comps" \
        --solar-home "$SOLAR_HOME" --claude-dir "$CLAUDE_DIR" "$@"
    # Gate on doctor: a broken update must surface as a nonzero exit.
    if ! doctor --json >/dev/null 2>&1; then
        echo "update applied but doctor reports problems; run: solar doctor" >&2
        exit 1
    fi
    echo "update complete: now at $new_sha ($channel)"
}

# Health check. Exits 0 only when the verdict is "ok"; exits 1 on any failure
# (missing install, missing critical path, or drift) so callers can branch on
# the exit code. Default output is a human checklist with per-line remedies;
# `--json` emits the machine-readable report (a superset of the old schema).
doctor() {
    mode="text"
    [ "${1:-}" = "--json" ] && mode="json"
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" \
    DOCTOR_MODE="$mode" python3 - <<'PY'
import json
import os
import sqlite3
import sys
from datetime import datetime, timezone

solar_home = os.environ["SOLAR_HOME"]
claude_dir = os.environ["CLAUDE_DIR"]
receipt_path = os.environ["RECEIPT_PATH"]
mode = os.environ.get("DOCTOR_MODE", "text")

result = {
    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "verdict": "ok",
    "components": [],
    "paths": {},
    "drift": [],
    "schema_version": None,
    "warnings": [],
}

receipt = None
if os.path.isfile(receipt_path):
    with open(receipt_path, encoding="utf-8") as f:
        receipt = json.load(f)
    result["components"] = receipt.get("components", [])
else:
    result["verdict"] = "fail"
    result["warnings"].append("install receipt missing")

checks = {
    "solar_home": solar_home,
    "receipt": receipt_path,
    "claude_dir": claude_dir,
    "kernel": os.path.join(claude_dir, "solar", "SOLAR.md"),
    "db": os.path.join(solar_home, "db", "solar.db"),
    "solar_bin": os.path.join(solar_home, "bin", "solar"),
}
remedies = {
    "solar_home": "reinstall: run install.sh (or get-solar.sh)",
    "receipt": "no install receipt found; run install.sh",
    "claude_dir": "create it, or pass --claude-dir to point at your Claude user dir",
    "kernel": "reinstall the kernel: install.sh --components kernel",
    "db": "reinstall to initialize the database",
    "solar_bin": "reinstall to restore the solar launcher",
}
fail_keys = {"solar_home", "receipt", "solar_bin"}
if "kernel" in result["components"] or not result["components"]:
    fail_keys.add("kernel")
for key, path in checks.items():
    ok = os.path.isdir(path) if key in ("solar_home", "claude_dir") else os.path.exists(path)
    result["paths"][key] = "ok" if ok else "missing"
    if not ok and key in fail_keys:
        result["verdict"] = "fail"
        result["warnings"].append("path missing: " + key)

# Drift check: every component root the receipt recorded must still exist.
# Catches a removed install tree (e.g. rm -rf ~/.solar/harness) that the fixed
# checks above do not cover.
if receipt:
    for name, roots in (receipt.get("component_roots") or {}).items():
        for root in roots:
            if not os.path.exists(root):
                result["drift"].append({"component": name, "path": root})
                result["verdict"] = "fail"
                result["warnings"].append("drift: %s root missing: %s" % (name, root))

# schema_version (informational): surfaces the migrations state recorded by the
# schema runner; never changes the verdict.
db_path = checks["db"]
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        row = conn.execute(
            "SELECT value FROM solar_meta WHERE key='schema_version'"
        ).fetchone()
        conn.close()
        if row:
            result["schema_version"] = row[0]
    except sqlite3.Error:
        pass

if mode == "json":
    print(json.dumps(result, indent=2, sort_keys=True))
else:
    print("OpenSolar doctor")
    for key, path in checks.items():
        ok = result["paths"][key] == "ok"
        print("  [%7s] %-11s %s" % ("ok" if ok else "MISSING", key, path))
        if not ok:
            print("            -> %s" % remedies.get(key, "reinstall"))
    if result["drift"]:
        print("  drift (tracked install paths now missing):")
        for d in result["drift"]:
            print("  [MISSING] %-11s %s" % (d["component"], d["path"]))
        print("            -> run `solar repair` to restore tracked files")
    if result["schema_version"] is not None:
        print("  schema_version: %s" % result["schema_version"])
    print("Verdict: %s" % result["verdict"])

sys.exit(0 if result["verdict"] == "ok" else 1)
PY
}

remove_sentinel() {
    [ -f "$CLAUDE_DIR/CLAUDE.md" ] || return 0
    python3 - "$CLAUDE_DIR/CLAUDE.md" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
begin = b"<!-- BEGIN OPENSOLAR -->"
end = b"<!-- END OPENSOLAR -->"
prefix_marker = b"<!-- OPENSOLAR-PREFIX: "


def find_region(text):
    start = text.find(begin)
    if start < 0:
        return None
    end_start = text.find(end, start + len(begin))
    if end_start < 0:
        return None
    region_end = end_start + len(end)
    if text[region_end:region_end + 2] == b"\r\n":
        region_end += 2
    elif text[region_end:region_end + 1] == b"\n":
        region_end += 1
    body = text[start:region_end]
    prefix_mode = b"none"
    marker_at = body.find(prefix_marker)
    if marker_at >= 0:
        value_start = marker_at + len(prefix_marker)
        value_end = body.find(b" -->", value_start)
        if value_end >= 0:
            prefix_mode = body[value_start:value_end]
    return start, region_end, prefix_mode


text = path.read_bytes()
region = find_region(text)
if region:
    start, region_end, prefix_mode = region
    if prefix_mode == b"newline" and start > 0 and text[start - 1:start] == b"\n":
        start -= 1
    path.write_bytes(text[:start] + text[region_end:])
PY
    if [ ! -s "$CLAUDE_DIR/CLAUDE.md" ]; then
        rm -f "$CLAUDE_DIR/CLAUDE.md"
    fi
}

# Stop and remove daemon services Solar registered (recorded at install time).
# Best-effort: missing launchctl/systemctl is not fatal.
remove_daemons() {
    record="$SOLAR_HOME/registered-daemons.txt"
    [ -f "$record" ] || return 0
    while IFS="$(printf '\t')" read -r kind label path; do
        case "$kind" in
            launchd)
                [ -f "$path" ] && launchctl unload "$path" >/dev/null 2>&1 || true
                rm -f "$path"
                ;;
            systemd)
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl --user disable --now "$label" >/dev/null 2>&1 || true
                fi
                rm -f "$path"
                # Remove now-empty systemd dirs Solar created (rmdir no-ops if
                # the dir still holds user content).
                rmdir "$HOME/.config/systemd/user" "$HOME/.config/systemd" "$HOME/.config" 2>/dev/null || true
                ;;
        esac
    done < "$record"
}

# Remove MCP servers Solar registered (recorded at install time), via the
# sanctioned claude CLI. Best-effort: a missing claude CLI is not fatal.
remove_mcp_servers() {
    record="$SOLAR_HOME/registered-mcp.txt"
    [ -f "$record" ] || return 0
    command -v claude >/dev/null 2>&1 || return 0
    while IFS= read -r server_name; do
        case "$server_name" in ''|'#'*) continue ;; esac
        claude mcp remove "$server_name" >/dev/null 2>&1 || true
    done < "$record"
}

remove_installed_skills() {
    manifest="$CLAUDE_DIR/solar/installed-skills.txt"
    [ -f "$manifest" ] || return 0
    while IFS= read -r skill_name; do
        case "$skill_name" in
            ""|.*|*/*) continue ;;
        esac
        skill_path="$CLAUDE_DIR/skills/$skill_name"
        if guard_path "$skill_path"; then
            rm -rf "$skill_path"
        fi
    done < "$manifest"
    rmdir "$CLAUDE_DIR/skills" 2>/dev/null || true
}

guard_path() {
    [ -n "$1" ] || return 1
    [ "$1" != "/" ] || return 1
    return 0
}

# Strip Solar-owned hook entries from settings.json, keyed by the
# "/solar/hooks/" command path segment. User-owned entries and other keys
# are preserved; if nothing else remains the file is removed (residue-free).
remove_solar_settings() {
    settings_file="$CLAUDE_DIR/settings.json"
    [ -f "$settings_file" ] || return 0
    python3 - "$settings_file" <<'PY'
import json
import os
import sys

settings_file = sys.argv[1]
marker = "/solar/hooks/"
with open(settings_file, encoding="utf-8") as f:
    text = f.read().strip()
settings = json.loads(text) if text else {}
hooks = settings.get("hooks", {}) if isinstance(settings, dict) else {}


def is_solar(cmd):
    return isinstance(cmd, str) and marker in cmd


for event in list(hooks.keys()):
    groups = hooks.get(event) or []
    new_groups = []
    for group in groups:
        if not isinstance(group, dict):
            new_groups.append(group)
            continue
        kept = [h for h in group.get("hooks", []) if not is_solar(h.get("command"))]
        if kept:
            g = dict(group)
            g["hooks"] = kept
            new_groups.append(g)
    if new_groups:
        hooks[event] = new_groups
    else:
        del hooks[event]
if isinstance(settings, dict) and not hooks:
    settings.pop("hooks", None)

if settings:
    tmp = settings_file + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    os.replace(tmp, settings_file)
else:
    os.remove(settings_file)
PY
}

uninstall() {
    yes=false
    keep_data=false
    dry_run=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) yes=true; shift ;;
            --keep-data) keep_data=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) echo "unknown uninstall option: $1" >&2; exit 2 ;;
        esac
    done

    if [ "$yes" != "true" ]; then
        echo "Refusing to uninstall without --yes." >&2
        exit 2
    fi
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "No install receipt found at $RECEIPT_PATH" >&2
        exit 1
    fi
    if [ "$dry_run" = "true" ]; then
        echo "Would remove OpenSolar files recorded under $SOLAR_HOME and $CLAUDE_DIR/solar"
        exit 0
    fi

    remove_sentinel
    remove_solar_settings
    remove_daemons
    remove_mcp_servers
    remove_installed_skills
    if guard_path "$CLAUDE_DIR/solar"; then
        rm -rf "$CLAUDE_DIR/solar"
    fi
    rmdir "$CLAUDE_DIR" 2>/dev/null || true
    if [ "$keep_data" = "true" ]; then
        # --keep-data contract: preserve ONLY the user's data (db/ + config.env
        # + .env) and remove EVERYTHING else under SOLAR_HOME (code, venv, bin,
        # node_modules, cache, logs, receipt, registered-*.txt, ...). Enumerate
        # what to KEEP (not what to remove) so new derived artifacts can never
        # silently survive a --keep-data uninstall.
        if guard_path "$SOLAR_HOME" && [ -d "$SOLAR_HOME" ]; then
            find "$SOLAR_HOME" -mindepth 1 -maxdepth 1 \
                ! -name db ! -name config.env ! -name .env \
                -exec rm -rf {} +
        fi
    elif guard_path "$SOLAR_HOME"; then
        rm -rf "$SOLAR_HOME"
    fi
    echo "OpenSolar uninstalled"
}

components_list() {
    if [ -f "$RECEIPT_PATH" ]; then
        python3 - "$RECEIPT_PATH" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as f:
    receipt = json.load(f)
for name in receipt.get("components", []):
    print(name)
PY
    fi
}

do_ui() {
    script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    helper=""
    for candidate in \
        "$SOLAR_HOME/harness/lib/cli/solar_ui_lite.py" \
        "$script_dir/../harness/lib/cli/solar_ui_lite.py"
    do
        if [ -f "$candidate" ]; then
            helper="$candidate"
            break
        fi
    done
    if [ -z "$helper" ]; then
        src=""
        if src="$(receipt_field source_dir 2>/dev/null)"; then
            if [ -f "$src/harness/lib/cli/solar_ui_lite.py" ]; then
                helper="$src/harness/lib/cli/solar_ui_lite.py"
            fi
        fi
    fi
    if [ -z "$helper" ]; then
        echo "Solar UI-lite helper not found; reinstall with harness or run from the source checkout." >&2
        exit 1
    fi
    command -v python3 >/dev/null 2>&1 || { echo "python3 is required for solar ui" >&2; exit 1; }
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" exec python3 "$helper" "$@"
}

cmd="${1:-}"
case "$cmd" in
    version) shift; do_version "$@" ;;
    doctor) shift; doctor "$@" ;;
    update) shift; do_update "$@" ;;
    repair) shift; do_repair "$@" ;;
    backup) shift; do_backup "$@" ;;
    restore) shift; do_restore "$@" ;;
    ui) shift; do_ui "$@" ;;
    uninstall) shift; uninstall "$@" ;;
    components)
        shift
        [ "${1:-}" = "list" ] || { usage; exit 2; }
        components_list
        ;;
    ""|--help|-h) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
