#!/usr/bin/env bash
set -e

config_value() {
    key="$1"
    file="$2"
    [ -f "$file" ] || return 1
    while IFS= read -r line; do
        case "$line" in
            "$key="*) printf '%s\n' "${line#*=}"; return 0 ;;
            "export $key="*) printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$file"
    return 1
}

receipt_value() {
    file="$1"
    key="$2"
    [ -f "$file" ] || return 1
    "$PYTHON_BIN" - "$file" "$key" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    value = json.load(f).get(sys.argv[2], "")
if value:
    print(value)
else:
    raise SystemExit(1)
PY
}

resolve_script_dir() {
    script="$0"
    case "$script" in
        */*) ;;
        *)
            found="$(command -v -- "$script" 2>/dev/null || true)"
            [ -n "$found" ] && script="$found"
            ;;
    esac
    while [ -L "$script" ]; do
        script_dir="$(CDPATH= cd -- "$(dirname -- "$script")" && pwd -P)"
        link="$(readlink "$script")" || break
        case "$link" in
            /*) script="$link" ;;
            *) script="$script_dir/$link" ;;
        esac
    done
    CDPATH= cd -- "$(dirname -- "$script")" && pwd -P
}

find_solar_python() {
    if [ -n "${SOLAR_PYTHON:-}" ] && [ -x "$SOLAR_PYTHON" ]; then
        case "$SOLAR_PYTHON" in
            *Microsoft/WindowsApps*|*WindowsApps*) ;;
            *) printf '%s\n' "$SOLAR_PYTHON"; return 0 ;;
        esac
    fi
    for cand in python3 python python3.14 python3.13 python3.12 python3.11; do
        found="$(command -v "$cand" 2>/dev/null || true)"
        case "$found" in
            *Microsoft/WindowsApps*|*WindowsApps*|"") ;;
            *) printf '%s\n' "$found"; return 0 ;;
        esac
    done
    printf 'python3\n'
}
PYTHON_BIN="$(find_solar_python)"

SCRIPT_DIR="$(resolve_script_dir)"
SCRIPT_SOLAR_HOME=""
if [ "$(basename -- "$SCRIPT_DIR")" = "bin" ]; then
    candidate_home="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
    if [ -f "$candidate_home/install-receipt.json" ] || [ -f "$candidate_home/config.env" ]; then
        SCRIPT_SOLAR_HOME="$candidate_home"
    fi
fi

SOLAR_HOME="${SOLAR_HOME:-${SCRIPT_SOLAR_HOME:-$HOME/.solar}}"
RECEIPT_PATH="$SOLAR_HOME/install-receipt.json"
if [ -z "${CLAUDE_DIR:-}" ]; then
    CLAUDE_DIR="$(config_value CLAUDE_DIR "$SOLAR_HOME/config.env" 2>/dev/null || true)"
fi
if [ -z "${CLAUDE_DIR:-}" ]; then
    CLAUDE_DIR="$(receipt_value "$RECEIPT_PATH" claude_dir 2>/dev/null || true)"
fi
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
DEFAULT_SOLAR_REPO="https://github.com/suraj-subrahmanyan/OpenSolar.git"

usage() {
    cat <<'EOF'
solar - OpenSolar lifecycle command

Usage:
  solar version [--json]
  solar status [--json]
  solar doctor [--json]
  solar update [extra install flags]
  solar repair [extra install flags]
  solar backup [--out FILE]
  solar restore <archive>
  solar identity register --local-only --username USER --password-stdin [--session-ttl SECONDS]
  solar identity login --username USER --password-stdin [--session-ttl SECONDS]
  solar identity session --token TOKEN
  solar identity logout --token TOKEN
  solar identity profile get|set ...
  solar privacy export|redact|delete ...
  solar channel status|route ...
  solar ui [--once] [--watch N] [--no-color]
  solar harness [verb] [args...]
  solar uninstall [--yes] [--keep-data] [--dry-run]
  solar components list
EOF
}

receipt_field() {
    [ -f "$RECEIPT_PATH" ] || return 1
    RECEIPT_PATH="$RECEIPT_PATH" "$PYTHON_BIN" - "$1" <<'PY'
import json
import os
import sys

with open(os.environ["RECEIPT_PATH"], encoding="utf-8") as f:
    receipt = json.load(f)
value = receipt.get(sys.argv[1], "")
if isinstance(value, list):
    print(",".join(value))
else:
    print(value)
PY
}

# Data paths under SOLAR_HOME that backup/restore and --keep-data treat as
# user data (config + secrets + receipt + database + local identity/profile).
SOLAR_DATA_PATHS="install-receipt.json config.env .env db identity"

do_version() {
    json=false
    [ "${1:-}" = "--json" ] && json=true
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    ver="$(receipt_field version)"; [ -n "$ver" ] || ver="unknown"
    sha="$(receipt_field git_sha)"
    chan="$(receipt_field channel)"
    repo="$(receipt_field repo)"
    if [ "$json" = "true" ]; then
        RV="$ver" RS="$sha" RC="$chan" RR="$repo" "$PYTHON_BIN" - <<'PY'
import json
import os

print(json.dumps({
    "version": os.environ.get("RV", ""),
    "git_sha": os.environ.get("RS", ""),
    "channel": os.environ.get("RC", ""),
    "repo": os.environ.get("RR", ""),
}, indent=2, sort_keys=True))
PY
    else
        printf 'OpenSolar %s' "$ver"
        if [ -n "$sha" ] && [ "$sha" != "unknown" ]; then
            printf ' (git %s)' "$sha"
        fi
        printf '\n'
        # A channel-less (pre-batch-2) receipt must not make the last command
        # false; that would propagate exit 1 under set -e despite valid output.
        if [ -n "$chan" ]; then
            printf 'channel: %s\n' "$chan"
        fi
    fi
}

do_backup() {
    out=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --out) out="$2"; shift 2 ;;
            *) echo "unknown backup option: $1" >&2; exit 2 ;;
        esac
    done
    [ -d "$SOLAR_HOME" ] || { echo "no Solar home at $SOLAR_HOME" >&2; exit 1; }
    set --
    for p in $SOLAR_DATA_PATHS; do
        [ -e "$SOLAR_HOME/$p" ] && set -- "$@" "$p"
    done
    [ "$#" -gt 0 ] || { echo "nothing to back up in $SOLAR_HOME" >&2; exit 1; }
    if [ -z "$out" ]; then
        mkdir -p "$SOLAR_HOME/backups"
        out="$SOLAR_HOME/backups/solar-backup-$(date -u +%Y%m%d%H%M%S).tar.gz"
    fi
    tar czf "$out" -C "$SOLAR_HOME" "$@"
    echo "backup written: $out"
}

do_status() {
    json=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --json) json=true; shift ;;
            --help|-h) echo "usage: solar status [--json]"; return 0 ;;
            *) echo "unknown status option: $1" >&2; exit 2 ;;
        esac
    done
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" \
    STATUS_JSON="$json" "$PYTHON_BIN" - <<'PY'
import http.client
import json
import os
import socket
import subprocess
import sys
from pathlib import Path


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def run_cmd(argv, timeout=5):
    try:
        # On Windows, directly executing a .sh script fails. Use bash to run the script.
        exec_argv = list(argv)
        if os.name == "nt":
            first = Path(argv[0])
            if not first.suffix.lower() in (".exe", ".bat", ".cmd"):
                # Assume it's a shell script; prepend bash
                exec_argv = ["bash"] + exec_argv
        proc = subprocess.run(
            exec_argv,
            check=False,
            text=True,
            capture_output=True,
            encoding='utf-8',
            errors='replace',
            timeout=timeout,
        )
        return proc.returncode, proc.stdout, proc.stderr
    except (FileNotFoundError, OSError) as exc:
        return 127, "", str(exc)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        return 124, out, err or f"timed out after {timeout}s"


def path_state(path, want_dir=False):
    ok = path.is_dir() if want_dir else path.exists()
    return "ok" if ok else "missing"


def live_pid(raw):
    text = str(raw or "").strip()
    if not text.isdigit():
        return False
    pid = int(text)
    if os.name == "nt":
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
            handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
            if handle:
                kernel32.CloseHandle(handle)
                return True
            return False
        except Exception:
            return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def tmux_session(name):
    rc, _, err = run_cmd(["tmux", "has-session", "-t", name], timeout=2)
    if rc == 0:
        return {"state": "present", "detail": name}
    if rc == 127:
        return {"state": "unavailable", "detail": "tmux not on PATH"}
    detail = (err or "").strip()
    return {"state": "absent", "detail": detail or name}


def recent_runtime_files(harness_dir):
    roots = [
        harness_dir / "run" / "operator-inbox",
        harness_dir / "run" / "operator-results",
        harness_dir / "run" / "operator-status",
        harness_dir / "run" / "queue",
        harness_dir / "sprints",
    ]
    found = []
    for root in roots:
        if not root.exists():
            continue
        for pattern in ("*.json", "*.jsonl", "*.status.json"):
            found.extend(p for p in root.rglob(pattern) if p.is_file())
    found.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    out = []
    for path in found[:5]:
        try:
            out.append(str(path.relative_to(harness_dir)))
        except ValueError:
            out.append(str(path))
    return out


def daemon_health(socket_path):
    if not socket_path.exists():
        return {"state": "not-running", "detail": f"socket missing: {socket_path}"}
    try:
        conn = http.client.HTTPConnection("localhost", timeout=1)
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(1)
        sock.connect(str(socket_path))
        conn.sock = sock
        conn.request("GET", "/health")
        resp = conn.getresponse()
        body = resp.read().decode("utf-8", "replace")
        conn.close()
        if resp.status == 200:
            try:
                payload = json.loads(body)
            except Exception:
                payload = {"raw": body.strip()}
            return {"state": "running", "detail": payload}
        return {"state": "error", "detail": f"HTTP {resp.status}: {body.strip()}"}
    except Exception as exc:
        return {"state": "error", "detail": str(exc)}


solar_home = Path(os.environ["SOLAR_HOME"]).expanduser()
claude_dir = Path(os.environ["CLAUDE_DIR"]).expanduser()
receipt_path = Path(os.environ["RECEIPT_PATH"]).expanduser()
json_mode = os.environ.get("STATUS_JSON") == "true"

receipt = load_json(receipt_path) if receipt_path.exists() else {}
components = receipt.get("components", []) if isinstance(receipt.get("components"), list) else []
solar_bin = solar_home / "bin" / "solar"
harness_bin = solar_home / "bin" / "solar-harness"
harness_dir = solar_home / "harness"
db_path = Path(receipt.get("db") or solar_home / "db" / "solar.db")

doctor = {}
doctor_error = ""
if solar_bin.exists():
    rc, out, err = run_cmd([str(solar_bin), "doctor", "--json"], timeout=8)
    if out.strip():
        try:
            doctor = json.loads(out)
        except Exception:
            doctor_error = out.strip()
    if rc != 0 and not doctor_error:
        doctor_error = (err or out).strip()

install_verdict = doctor.get("verdict")
if not install_verdict:
    install_verdict = "ok" if receipt_path.exists() and solar_bin.exists() else "fail"
if not receipt_path.exists() or not solar_bin.exists():
    install_verdict = "fail"

coordinator = "not-installed"
pidfile = harness_dir / ".coordinator.pid"
if harness_dir.exists():
    coordinator = "not-running"
    if pidfile.exists():
        pid = pidfile.read_text(encoding="utf-8", errors="replace").strip()
        coordinator = f"alive pid={pid}" if live_pid(pid) else f"stale pid={pid or 'unknown'}"

daemon_bin = solar_home / "bin" / "solar-daemon"
daemon_core = solar_home / "core" / "daemon" / "server.ts"
registered_daemons = solar_home / "registered-daemons.txt"
daemon_installed = (
    "core-runtime" in components
    or "daemons" in components
    or daemon_core.exists()
)
daemon = {
    "component": "installed" if daemon_installed else "not-installed",
    "service_component": "installed" if "daemons" in components else "not-installed",
    "binary": str(daemon_bin) if daemon_bin.exists() else "",
    "registered_daemons": str(registered_daemons) if registered_daemons.exists() else "",
    "socket": "/tmp/solar.sock",
}
daemon.update(daemon_health(Path("/tmp/solar.sock")) if daemon_installed else {
    "state": "not-installed",
    "detail": "core-runtime/daemons component not installed",
})

status = {
    "install": {
        "verdict": install_verdict,
        "version": receipt.get("version") or "unknown",
        "git_sha": receipt.get("git_sha") or "",
        "channel": receipt.get("channel") or "",
        "repo": receipt.get("repo") or "",
        "components": components,
        "schema_version": doctor.get("schema_version"),
        "receipt": str(receipt_path),
        "doctor_error": doctor_error,
        "paths": {
            "solar_home": {"state": path_state(solar_home, True), "path": str(solar_home)},
            "receipt": {"state": path_state(receipt_path), "path": str(receipt_path)},
            "solar_bin": {"state": path_state(solar_bin), "path": str(solar_bin)},
            "kernel": {"state": path_state(claude_dir / "solar" / "SOLAR.md"), "path": str(claude_dir / "solar" / "SOLAR.md")},
            "db": {"state": path_state(db_path), "path": str(db_path)},
        },
    },
    "runtime": {
        "harness": "installed" if harness_bin.exists() or harness_dir.exists() else "not-installed",
        "harness_bin": str(harness_bin) if harness_bin.exists() else "",
        "product_delivery_session": tmux_session("solar-harness"),
        "builder_lab_session": tmux_session("solar-harness-lab"),
        "coordinator": coordinator,
        "recent_artifacts": recent_runtime_files(harness_dir),
    },
    "daemon": daemon,
}

if json_mode:
    print(json.dumps(status, indent=2, sort_keys=True))
else:
    print("OpenSolar status")
    print("Install")
    print(f"  health: {status['install']['verdict']}")
    print(f"  version: {status['install']['version']}")
    if status["install"]["git_sha"]:
        print(f"  git: {status['install']['git_sha']}")
    if status["install"]["channel"]:
        print(f"  channel: {status['install']['channel']}")
    print("  components: " + (",".join(components) if components else "(none recorded)"))
    if status["install"]["schema_version"] is not None:
        print(f"  schema_version: {status['install']['schema_version']}")
    print(f"  receipt: {receipt_path} ({status['install']['paths']['receipt']['state']})")
    if doctor_error:
        print(f"  doctor detail: {doctor_error}")
    print("Runtime")
    print(f"  harness: {status['runtime']['harness']}")
    if status["runtime"]["harness_bin"]:
        print(f"  harness_bin: {status['runtime']['harness_bin']}")
    print("  tmux product_delivery: {state} ({detail})".format(**status["runtime"]["product_delivery_session"]))
    print("  tmux builder_lab: {state} ({detail})".format(**status["runtime"]["builder_lab_session"]))
    print(f"  coordinator: {status['runtime']['coordinator']}")
    recent = status["runtime"]["recent_artifacts"]
    print("  recent artifacts: " + (", ".join(recent[:3]) if recent else "none found"))
    print("Daemon")
    print(f"  component: {status['daemon']['component']}")
    print(f"  service component: {status['daemon']['service_component']}")
    print(f"  state: {status['daemon']['state']}")
    detail = status["daemon"]["detail"]
    if isinstance(detail, dict):
        detail = json.dumps(detail, sort_keys=True)
    print(f"  detail: {detail}")

sys.exit(0 if install_verdict == "ok" else 1)
PY
}

do_restore() {
    archive="${1:-}"
    [ -n "$archive" ] || { echo "usage: solar restore <archive>" >&2; exit 2; }
    [ -f "$archive" ] || { echo "archive not found: $archive" >&2; exit 1; }
    mkdir -p "$SOLAR_HOME"
    tar xzf "$archive" -C "$SOLAR_HOME"
    echo "restored from $archive into $SOLAR_HOME"
}

# Reinstall in place from the source checkout the receipt recorded -- no fetch.
# Useful when an install is locally damaged; this is the old `update` behavior,
# which never actually fetched anything, kept under an honest name.
do_repair() {
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    src="$(receipt_field source_dir)"
    comps="$(receipt_field components)"
    [ -n "$src" ] || { echo "receipt has no source_dir" >&2; exit 1; }
    [ -n "$comps" ] || { echo "receipt has no components" >&2; exit 1; }
    if [ ! -f "$src/install.sh" ]; then
        echo "installer not found at $src/install.sh; re-clone the source (or run solar update) to repair" >&2
        exit 1
    fi
    echo "repairing from $src (components: $comps)"
    "$src/install.sh" --yes --components "$comps" \
        --solar-home "$SOLAR_HOME" --claude-dir "$CLAUDE_DIR" "$@"
}

# Clone <repo>@<channel> into <dest> (shallow), with one retry. Mirrors
# get-solar.sh fetch_source. Returns nonzero if both attempts fail.
fetch_channel() {
    _repo="$1"; _channel="$2"; _dest="$3"
    rm -rf "$_dest"
    mkdir -p "$(dirname "$_dest")"
    if git clone --depth 1 --branch "$_channel" "$_repo" "$_dest" >/dev/null 2>&1; then
        return 0
    fi
    rm -rf "$_dest"
    git clone --depth 1 --branch "$_channel" "$_repo" "$_dest" >/dev/null 2>&1
}

# Compare two release versions (e.g. 1.0.0-rc.6 vs 1.0.0). Prints lt|eq|gt,
# or "unknown" when either side is missing/unparseable. Pre-releases order
# BEFORE their final release: the "-rc." suffix is normalized to Debian's
# tilde, which GNU sort -V ranks below end-of-string (1.0.0~rc.8 < 1.0.0).
version_compare() {
    a="${1:-}"; b="${2:-}"
    if [ -z "$a" ] || [ -z "$b" ] || [ "$a" = "unknown" ] || [ "$b" = "unknown" ]; then
        echo unknown; return 0
    fi
    an="$(printf '%s' "$a" | sed 's/^v//; s/-/~/')"
    bn="$(printf '%s' "$b" | sed 's/^v//; s/-/~/')"
    if [ "$an" = "$bn" ]; then echo eq; return 0; fi
    first="$(printf '%s\n%s\n' "$an" "$bn" | sort -V | head -n1)"
    if [ "$first" = "$an" ]; then echo lt; else echo gt; fi
    return 0
}

# Recover the fetchable tag for a pre-channel receipt.  Development describe
# strings (for example 1.0.0-rc.8-6-gabc123) are deliberately rejected: they
# are not guaranteed to exist as remote refs, so guessing would make update
# fetch an unrelated tree.  A user can still recover explicitly with
# SOLAR_CHANNEL when the old receipt lacks a release version.
release_channel_from_version() {
    candidate="${1:-}"
    if printf '%s\n' "$candidate" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$'; then
        printf 'v%s\n' "$candidate"
        return 0
    fi
    return 1
}

# Real update: fetch the recorded channel, compare against the installed sha,
# and either report up-to-date or reinstall from the fetched source (which runs
# db_init + migrations + rewrites the receipt), then gate on doctor.
do_update() {
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "no install receipt at $RECEIPT_PATH; run install.sh first" >&2
        exit 1
    fi
    comps="$(receipt_field components)"
    repo="$(receipt_field repo)"
    channel="$(receipt_field channel)"
    cur_sha="$(receipt_field git_sha)"
    cur_version="$(receipt_field version)"
    [ -n "$comps" ] || { echo "receipt has no components" >&2; exit 1; }
    # Pre-channel receipts recover only onto the maintained repository and the
    # release tag recorded by their own installed version.  Never silently
    # redirect an old installation to a different fork or a stale fixed tag.
    [ -n "$repo" ] || repo="${SOLAR_REPO:-$DEFAULT_SOLAR_REPO}"
    if [ -z "$channel" ]; then
        channel="${SOLAR_CHANNEL:-}"
        [ -n "$channel" ] || channel="$(release_channel_from_version "$cur_version" || true)"
    fi
    if [ -z "$channel" ]; then
        echo "update failed: legacy receipt has no fetchable release channel" >&2
        echo "  reinstall from the current OpenSolar release, or set SOLAR_CHANNEL explicitly." >&2
        exit 1
    fi

    command -v git >/dev/null 2>&1 || {
        echo "git is required for solar update; install git, or use solar repair to reinstall in place" >&2
        exit 1
    }

    fetch_dir="${SOLAR_SRC:-$HOME/.solar-src/OpenSolar}"
    tmp_fetch="$fetch_dir.update.$$"
    # Clean any stale temp clones a previously interrupted update left behind.
    for stale in "$fetch_dir".update.*; do
        [ -e "$stale" ] && rm -rf "$stale"
    done
    echo "fetching $repo (channel: $channel)" >&2
    if ! fetch_channel "$repo" "$channel" "$tmp_fetch"; then
        rm -rf "$tmp_fetch"
        echo "update failed: could not fetch channel '$channel' from $repo" >&2
        echo "  check the network and channel, or run solar repair to reinstall from the recorded source." >&2
        exit 1
    fi
    if [ ! -f "$tmp_fetch/install.sh" ]; then
        rm -rf "$tmp_fetch"
        echo "update failed: install.sh not found in the fetched channel ($channel)" >&2
        exit 1
    fi
    new_sha="$(git -C "$tmp_fetch" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    new_full="$(git -C "$tmp_fetch" rev-parse HEAD 2>/dev/null || echo unknown)"

    # cur_sha (from the receipt) is an abbreviation whose length depends on the
    # repo it was resolved in, which may differ from the shallow fetch's. Treat
    # "up to date" when it is a prefix of the fetched full sha, rather than
    # requiring equal short strings.
    if [ -n "$cur_sha" ] && [ "$cur_sha" != "unknown" ] && [ "$new_full" != "unknown" ]; then
        case "$new_full" in
            "$cur_sha"*)
                echo "already up to date ($cur_sha on $channel)"
                rm -rf "$tmp_fetch"
                return 0
                ;;
        esac
    fi

    # A receipt's channel can lag the installed tree (rc.8 installs recorded
    # rc.6 — P6 corpus PKG-001), so fetching the recorded channel must never
    # silently move an install BACKWARDS. Refuse a downgrade unless forced.
    [ -n "$cur_version" ] || cur_version="$(cat "$fetch_dir/VERSION" 2>/dev/null || echo unknown)"
    new_version="$(cat "$tmp_fetch/VERSION" 2>/dev/null || echo unknown)"
    if [ "${SOLAR_UPDATE_ALLOW_DOWNGRADE:-0}" != "1" ] \
        && [ "$(version_compare "$new_version" "$cur_version")" = "lt" ]; then
        rm -rf "$tmp_fetch"
        echo "update refused: channel '$channel' serves version $new_version, OLDER than installed $cur_version" >&2
        echo "  the recorded update channel is stale; reinstall from the current release to fix it," >&2
        echo "  or rerun with SOLAR_UPDATE_ALLOW_DOWNGRADE=1 to downgrade deliberately." >&2
        exit 1
    fi

    echo "updating $cur_sha -> $new_sha (channel: $channel, components: $comps)" >&2
    # Promote the fetch to the canonical source dir so future update/repair find
    # it, then reinstall from it.
    rm -rf "$fetch_dir"
    mkdir -p "$(dirname "$fetch_dir")"
    mv "$tmp_fetch" "$fetch_dir"
    SOLAR_REPO="$repo" SOLAR_CHANNEL="$channel" \
        "$fetch_dir/install.sh" --yes --components "$comps" \
        --solar-home "$SOLAR_HOME" --claude-dir "$CLAUDE_DIR" "$@"
    # Gate on doctor: a broken update must surface as a nonzero exit.
    if ! doctor --json >/dev/null 2>&1; then
        echo "update applied but doctor reports problems; run: solar doctor" >&2
        exit 1
    fi
    echo "update complete: now at $new_sha ($channel)"
}

# Health check. Exits 0 only when the verdict is "ok"; exits 1 on any failure
# (missing install, missing critical path, or drift) so callers can branch on
# the exit code. Default output is a human checklist with per-line remedies;
# `--json` emits the machine-readable report (a superset of the old schema).
doctor() {
    mode="text"
    [ "${1:-}" = "--json" ] && mode="json"
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" \
    SOLAR_PYTHON="${SOLAR_PYTHON:-$PYTHON_BIN}" DOCTOR_MODE="$mode" "$PYTHON_BIN" - <<'PY'
import json
import os
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone

solar_home = os.environ["SOLAR_HOME"]
claude_dir = os.environ["CLAUDE_DIR"]
receipt_path = os.environ["RECEIPT_PATH"]
mode = os.environ.get("DOCTOR_MODE", "text")

result = {
    "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "verdict": "ok",
    "components": [],
    "paths": {},
    "python": {},
    "system": {},
    "runtime": {},
    "models": {},
    "drift": [],
    "schema_version": None,
    "warnings": [],
}


def run_cmd(argv, timeout=5):
    try:
        proc = subprocess.run(
            argv,
            check=False,
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except FileNotFoundError as exc:
        return 127, "", str(exc)
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        return 124, out.strip(), (err or f"timed out after {timeout}s").strip()


def first_bash4():
    checked = set()
    for name in ("bash", "bash5", "bash4", "/opt/homebrew/bin/bash", "/usr/local/bin/bash", "/usr/bin/bash", "/bin/bash"):
        path = name if os.path.isabs(name) and os.path.exists(name) else shutil.which(name)
        if not path or path in checked:
            continue
        checked.add(path)
        rc, out, _ = run_cmd([path, "-c", 'printf "%s" "${BASH_VERSINFO[0]:-0}"'])
        try:
            if rc == 0 and int(out or "0") >= 4:
                return path
        except ValueError:
            pass
    return ""


def env_file_has_key(path, keys):
    try:
        with open(path, encoding="utf-8") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                if key.startswith("export "):
                    key = key[len("export "):].strip()
                if key in keys and value.strip().strip('"').strip("'"):
                    return True
    except OSError:
        return False
    return False


def credential_present(keys):
    if any(os.environ.get(k) for k in keys):
        return True
    secrets_dir = os.path.join(solar_home, "secrets")
    for name in ("zhipu.env", "solar-user-secrets.env", "anthropic.env"):
        if env_file_has_key(os.path.join(secrets_dir, name), keys):
            return True
    return False

receipt = None
if os.path.isfile(receipt_path):
    with open(receipt_path, encoding="utf-8") as f:
        receipt = json.load(f)
    result["components"] = receipt.get("components", [])
else:
    result["verdict"] = "fail"
    result["warnings"].append("install receipt missing")

checks = {
    "solar_home": solar_home,
    "receipt": receipt_path,
    "claude_dir": claude_dir,
    "kernel": os.path.join(claude_dir, "solar", "SOLAR.md"),
    "db": os.path.join(solar_home, "db", "solar.db"),
    "solar_bin": os.path.join(solar_home, "bin", "solar"),
}
remedies = {
    "solar_home": "reinstall: run install.sh (or get-solar.sh)",
    "receipt": "no install receipt found; run install.sh",
    "claude_dir": "create it, or pass --claude-dir to point at your Claude user dir",
    "kernel": "reinstall the kernel: install.sh --components kernel",
    "db": "reinstall to initialize the database",
    "solar_bin": "reinstall to restore the solar launcher",
}
fail_keys = {"solar_home", "receipt", "solar_bin"}
if "kernel" in result["components"] or not result["components"]:
    fail_keys.add("kernel")
for key, path in checks.items():
    ok = os.path.isdir(path) if key in ("solar_home", "claude_dir") else os.path.exists(path)
    result["paths"][key] = "ok" if ok else "missing"
    if not ok and key in fail_keys:
        result["verdict"] = "fail"
        result["warnings"].append("path missing: " + key)

py_env = os.environ.get("SOLAR_PYTHON", "").strip()
if py_env and os.path.exists(py_env) and "WindowsApps" not in py_env:
    py_path = py_env
else:
    py_path = sys.executable if "WindowsApps" not in sys.executable else (shutil.which("python") or shutil.which("python3") or "")
py_version = ""
py_min_ok = False
if py_path:
    rc, out, err = run_cmd([py_path, "-c", 'import sys; print("%d.%d.%d" % sys.version_info[:3]); raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'])
    py_version = out.splitlines()[0] if out else ""
    py_min_ok = rc == 0
    if not py_min_ok:
        result["verdict"] = "fail"
        result["warnings"].append("python3 must be 3.11+; current: %s %s" % (py_path, py_version or err))
else:
    result["verdict"] = "fail"
    result["warnings"].append("python3 missing")

imports = {}
if "harness" in result["components"]:
    for mod in ("yaml", "jsonschema", "pydantic", "rich"):
        if py_path:
            rc, _, err = run_cmd([py_path, "-c", "import " + mod])
            imports[mod] = "ok" if rc == 0 else "missing"
            if rc != 0:
                result["verdict"] = "fail"
                result["warnings"].append("harness python dependency missing: %s (%s)" % (mod, err or py_path))
        else:
            imports[mod] = "missing"
result["python"] = {
    "path": py_path,
    "version": py_version,
    "requires": ">=3.11",
    "min_ok": py_min_ok,
    "harness_imports": imports,
}

bash4 = first_bash4()
system = {
    "tmux": {"state": "ok" if shutil.which("tmux") else "missing", "path": shutil.which("tmux") or ""},
    "jq": {"state": "ok" if shutil.which("jq") else "missing", "path": shutil.which("jq") or ""},
    "bash>=4": {"state": "ok" if bash4 else "missing", "path": bash4},
}
result["system"] = system
for name, item in system.items():
    if item["state"] != "ok":
        result["warnings"].append("system dependency missing: " + name)

lab_matrix = ""
cfg = {}
user_config = os.path.join(solar_home, "harness", "config", "solar-user-config.json")
try:
    with open(user_config, encoding="utf-8") as f:
        cfg = json.load(f)
    lab_matrix = str(((cfg.get("models") or {}).get("lab_builder_matrix")) or "")
except Exception:
    pass
if not lab_matrix:
    lab_matrix = "unknown"

zhipu_ready = credential_present({"ZHIPU_AUTH_TOKEN", "ZHIPU_API_KEY"})
anthropic_ready = credential_present({"ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"})
claude_cli = shutil.which("claude") or ""
codex_cli = shutil.which("codex") or ""
uses_glm = "glm" in lab_matrix.lower() or "zhipu" in lab_matrix.lower()
runtime_override = str(os.environ.get("SOLAR_PANE_RUNTIME") or "").strip()
selected_runtime = str(runtime_override or cfg.get("runtime") or "claude").strip().lower()
runtime_source = (
    "SOLAR_PANE_RUNTIME"
    if runtime_override
    else "solar-user-config.json"
    if cfg.get("runtime")
    else "default"
)
home_dir = os.path.expanduser("~")


def nonempty_file(path):
    try:
        return os.path.isfile(path) and os.path.getsize(path) > 0
    except OSError:
        return False


if selected_runtime == "codex":
    runtime_label = "Codex"
    runtime_cli = codex_cli
    codex_home = os.path.expanduser(os.environ.get("CODEX_HOME") or os.path.join(home_dir, ".codex"))
    runtime_auth = bool(os.environ.get("OPENAI_API_KEY")) or nonempty_file(os.path.join(codex_home, "auth.json"))
    login_command = "codex login --device-auth"
    runtime_guidance = (
        "Run `codex login --device-auth` once, then start the cockpit with "
        "`solar harness start <project-dir>`."
    )
elif selected_runtime == "claude":
    runtime_label = "Claude Code"
    runtime_cli = claude_cli
    runtime_auth = bool(os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")) or nonempty_file(
        os.path.join(claude_dir, ".credentials.json")
    )
    login_command = "claude"
    runtime_guidance = (
        "Run `claude` once and complete login/trust, then start the cockpit with "
        "`solar harness start <project-dir>`."
    )
else:
    runtime_label = selected_runtime or "unknown"
    runtime_cli = ""
    runtime_auth = False
    login_command = ""
    runtime_guidance = "Set runtime to `codex` or `claude` in solar-user-config.json."
    result["verdict"] = "fail"
    result["warnings"].append(
        "unsupported selected runtime: %s (expected codex or claude)" % (selected_runtime or "empty")
    )

result["runtime"] = {
    "selected": selected_runtime,
    "label": runtime_label,
    "source": runtime_source,
    "cli": "present" if runtime_cli else "missing",
    "cli_path": runtime_cli,
    "auth": "ok" if runtime_auth else "unauthenticated",
    "login_command": login_command,
    "guidance": runtime_guidance,
}
result["models"] = {
    "lab_matrix": lab_matrix,
    "zhipu_credentials": "present" if zhipu_ready else "missing",
    "anthropic_credentials": "present" if anthropic_ready else "missing",
    "claude_cli": "present" if claude_cli else "missing",
    "claude_cli_path": claude_cli,
    "guidance": (
        "Provide ZHIPU_AUTH_TOKEN in ~/.solar/secrets/zhipu.env or "
        "~/.solar/secrets/solar-user-secrets.env."
        if uses_glm
        else "Role-model overrides are optional; the selected runtime supplies the default provider route."
    ),
}
if uses_glm and not zhipu_ready:
    result["warnings"].append("lab matrix uses GLM/Zhipu but no ZHIPU credentials were found")
if selected_runtime in {"codex", "claude"} and not runtime_cli:
    result["warnings"].append(
        "selected %s runtime CLI missing; install it before launching panes" % runtime_label
    )
elif selected_runtime in {"codex", "claude"} and not runtime_auth:
    result["warnings"].append(
        "selected %s runtime appears unauthenticated; run: %s" % (runtime_label, login_command)
    )

# Drift check: every component root the receipt recorded must still exist.
# Catches a removed install tree (e.g. rm -rf ~/.solar/harness) that the fixed
# checks above do not cover.
if receipt:
    for name, roots in (receipt.get("component_roots") or {}).items():
        for root in roots:
            if not os.path.exists(root):
                result["drift"].append({"component": name, "path": root})
                result["verdict"] = "fail"
                result["warnings"].append("drift: %s root missing: %s" % (name, root))

# schema_version (informational): surfaces the migrations state recorded by the
# schema runner; never changes the verdict.
db_path = checks["db"]
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        row = conn.execute(
            "SELECT value FROM solar_meta WHERE key='schema_version'"
        ).fetchone()
        conn.close()
        if row:
            result["schema_version"] = row[0]
    except sqlite3.Error:
        pass

if mode == "json":
    print(json.dumps(result, indent=2, sort_keys=True))
else:
    print("OpenSolar doctor")
    for key, path in checks.items():
        ok = result["paths"][key] == "ok"
        print("  [%7s] %-11s %s" % ("ok" if ok else "MISSING", key, path))
        if not ok:
            print("            -> %s" % remedies.get(key, "reinstall"))
    if result["drift"]:
        print("  drift (tracked install paths now missing):")
        for d in result["drift"]:
            print("  [MISSING] %-11s %s" % (d["component"], d["path"]))
        print("            -> run `solar repair` to restore tracked files")
    py = result["python"]
    print("  [%7s] %-11s %s %s" % (
        "ok" if py.get("min_ok") else "MISSING",
        "python3",
        py.get("path") or "(missing)",
        py.get("version") or "",
    ))
    if py.get("harness_imports"):
        for mod, state in py["harness_imports"].items():
            print("  [%7s] %-11s %s" % ("ok" if state == "ok" else "MISSING", "py:" + mod, state))
    for name, item in result["system"].items():
        print("  [%7s] %-11s %s" % (
            "ok" if item.get("state") == "ok" else "MISSING",
            name,
            item.get("path") or item.get("state"),
        ))
    runtime = result["runtime"]
    if runtime:
        print("  selected runtime: %s (%s)" % (
            runtime.get("selected", "unknown"),
            runtime.get("source", "unknown"),
        ))
        print("  runtime CLI/auth: %s/%s" % (
            runtime.get("cli", "missing"),
            runtime.get("auth", "unauthenticated"),
        ))
        print("  runtime guidance: %s" % runtime.get("guidance", ""))
    models = result["models"]
    if models:
        print("  model lab matrix: %s" % models.get("lab_matrix", "unknown"))
        print("  optional provider credentials: zhipu=%s anthropic=%s" % (
            models.get("zhipu_credentials", "missing"),
            models.get("anthropic_credentials", "missing"),
        ))
        print("  model guidance: %s" % models.get("guidance", ""))
    if result["schema_version"] is not None:
        print("  schema_version: %s" % result["schema_version"])
    if result["warnings"]:
        print("  warnings:")
        for warning in result["warnings"]:
            print("    - %s" % warning)
    print("Verdict: %s" % result["verdict"])

sys.exit(0 if result["verdict"] == "ok" else 1)
PY
}

remove_sentinel() {
    [ -f "$CLAUDE_DIR/CLAUDE.md" ] || return 0
    "$PYTHON_BIN" - "$CLAUDE_DIR/CLAUDE.md" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
begin = b"<!-- BEGIN OPENSOLAR -->"
end = b"<!-- END OPENSOLAR -->"
prefix_marker = b"<!-- OPENSOLAR-PREFIX: "


def find_region(text):
    start = text.find(begin)
    if start < 0:
        return None
    end_start = text.find(end, start + len(begin))
    if end_start < 0:
        return None
    region_end = end_start + len(end)
    if text[region_end:region_end + 2] == b"\r\n":
        region_end += 2
    elif text[region_end:region_end + 1] == b"\n":
        region_end += 1
    body = text[start:region_end]
    prefix_mode = b"none"
    marker_at = body.find(prefix_marker)
    if marker_at >= 0:
        value_start = marker_at + len(prefix_marker)
        value_end = body.find(b" -->", value_start)
        if value_end >= 0:
            prefix_mode = body[value_start:value_end]
    return start, region_end, prefix_mode


text = path.read_bytes()
region = find_region(text)
if region:
    start, region_end, prefix_mode = region
    if prefix_mode == b"newline" and start > 0 and text[start - 1:start] == b"\n":
        start -= 1
    path.write_bytes(text[:start] + text[region_end:])
PY
    if [ ! -s "$CLAUDE_DIR/CLAUDE.md" ]; then
        rm -f "$CLAUDE_DIR/CLAUDE.md"
    fi
}

# Stop and remove daemon services Solar registered (recorded at install time).
# Best-effort: missing launchctl/systemctl is not fatal.
remove_daemons() {
    record="$SOLAR_HOME/registered-daemons.txt"
    [ -f "$record" ] || return 0
    while IFS="$(printf '\t')" read -r kind label path; do
        case "$kind" in
            launchd)
                [ -f "$path" ] && launchctl unload "$path" >/dev/null 2>&1 || true
                rm -f "$path"
                ;;
            systemd)
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl --user disable --now "$label" >/dev/null 2>&1 || true
                fi
                rm -f "$path"
                # Remove now-empty systemd dirs Solar created (rmdir no-ops if
                # the dir still holds user content).
                rmdir "$HOME/.config/systemd/user" "$HOME/.config/systemd" "$HOME/.config" 2>/dev/null || true
                ;;
        esac
    done < "$record"
}

# Remove MCP servers Solar registered (recorded at install time), via the
# sanctioned claude CLI. Best-effort: a missing claude CLI is not fatal.
remove_mcp_servers() {
    record="$SOLAR_HOME/registered-mcp.txt"
    [ -f "$record" ] || return 0
    command -v claude >/dev/null 2>&1 || return 0
    while IFS= read -r server_name; do
        case "$server_name" in ''|'#'*) continue ;; esac
        claude mcp remove "$server_name" >/dev/null 2>&1 || true
    done < "$record"
}

remove_installed_skills() {
    manifest="$CLAUDE_DIR/solar/installed-skills.txt"
    [ -f "$manifest" ] || return 0
    while IFS= read -r skill_name; do
        case "$skill_name" in
            ""|.*|*/*) continue ;;
        esac
        skill_path="$CLAUDE_DIR/skills/$skill_name"
        if guard_path "$skill_path"; then
            rm -rf "$skill_path"
        fi
    done < "$manifest"
    rmdir "$CLAUDE_DIR/skills" 2>/dev/null || true
}

guard_path() {
    [ -n "$1" ] || return 1
    [ "$1" != "/" ] || return 1
    return 0
}

# Strip Solar-owned hook entries from settings.json, keyed by the
# "/solar/hooks/" command path segment. User-owned entries and other keys
# are preserved; if nothing else remains the file is removed (residue-free).
remove_solar_settings() {
    settings_file="$CLAUDE_DIR/settings.json"
    [ -f "$settings_file" ] || return 0
    "$PYTHON_BIN" - "$settings_file" <<'PY'
import json
import os
import sys

settings_file = sys.argv[1]
marker = "/solar/hooks/"
with open(settings_file, encoding="utf-8") as f:
    text = f.read().strip()
settings = json.loads(text) if text else {}
hooks = settings.get("hooks", {}) if isinstance(settings, dict) else {}


def is_solar(cmd):
    return isinstance(cmd, str) and marker in cmd


for event in list(hooks.keys()):
    groups = hooks.get(event) or []
    new_groups = []
    for group in groups:
        if not isinstance(group, dict):
            new_groups.append(group)
            continue
        kept = [h for h in group.get("hooks", []) if not is_solar(h.get("command"))]
        if kept:
            g = dict(group)
            g["hooks"] = kept
            new_groups.append(g)
    if new_groups:
        hooks[event] = new_groups
    else:
        del hooks[event]
if isinstance(settings, dict) and not hooks:
    settings.pop("hooks", None)

if settings:
    tmp = settings_file + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")
    os.replace(tmp, settings_file)
else:
    os.remove(settings_file)
PY
}

remove_python_user_deps() {
    manifest="$SOLAR_HOME/python-user-deps.json"
    [ -f "$manifest" ] || return 0
    command -v "$PYTHON_BIN" >/dev/null 2>&1 || return 0
    if ! "$PYTHON_BIN" - "$manifest" <<'PY'
import importlib.metadata as metadata
import json
import os
import re
import sys
from pathlib import Path


def normalize(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def resolved(path):
    return Path(path).expanduser().resolve(strict=False)


def under(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def unlink_path(path):
    try:
        if path.is_dir() and not path.is_symlink():
            return
        path.unlink()
    except FileNotFoundError:
        pass


def add_prune_ancestors(start, root, dirs):
    path = start
    while under(path, root):
        dirs.add(path)
        if path == root:
            break
        path = path.parent


def unlink_generated_cache(source_path, allowed_root, dirs):
    if source_path.suffix != ".py":
        return
    cache_dir = source_path.parent / "__pycache__"
    if not cache_dir.is_dir():
        return
    prefix = source_path.stem + "."
    for cache_path in cache_dir.glob(prefix + "*.pyc"):
        cache_path = resolved(cache_path)
        if under(cache_path, allowed_root):
            unlink_path(cache_path)
            add_prune_ancestors(cache_path.parent, allowed_root, dirs)


def prune_empty_dirs(dirs, allowed_root):
    for path in sorted(dirs, key=lambda item: len(item.parts), reverse=True):
        if not under(path, allowed_root):
            continue
        try:
            path.rmdir()
        except OSError:
            pass


def prune_to_root(start, root):
    path = start
    while under(path, root):
        try:
            path.rmdir()
        except FileNotFoundError:
            pass
        except OSError:
            break
        if path == root:
            break
        path = path.parent


def prune_ancestors_to_home(start):
    home = os.environ.get("HOME")
    if not home:
        return
    home_root = resolved(home)
    path = start
    while under(path, home_root) and path != home_root:
        try:
            path.rmdir()
        except OSError:
            break
        path = path.parent


manifest_path = Path(sys.argv[1])
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
entries = manifest.get("entries")
if not isinstance(entries, list):
    entries = []

for entry in entries:
    if not isinstance(entry, dict):
        continue
    packages = {normalize(name) for name in entry.get("packages", []) if isinstance(name, str)}
    if not packages:
        continue
    user_site = entry.get("user_site")
    if not user_site:
        continue
    site_root = resolved(user_site)
    if not site_root.exists():
        continue
    user_base = resolved(entry.get("user_base") or site_root)
    dirs = set()
    dists = list(metadata.distributions(path=[str(site_root)]))
    for dist in dists:
        name = dist.metadata.get("Name")
        if not name or normalize(name) not in packages:
            continue
        dist_files = dist.files or []
        paths = []
        for rel_path in dist_files:
            target = resolved(dist.locate_file(rel_path))
            if not under(target, user_base):
                continue
            paths.append(target)
            add_prune_ancestors(target.parent, user_base, dirs)
        dist_path = getattr(dist, "_path", None)
        if dist_path is not None:
            dist_path = resolved(dist_path)
            if under(dist_path, user_base):
                add_prune_ancestors(dist_path, user_base, dirs)
        for path in sorted(set(paths), key=lambda item: len(item.parts), reverse=True):
            unlink_generated_cache(path, user_base, dirs)
            unlink_path(path)
    prune_empty_dirs(dirs, user_base)
    prune_to_root(site_root, user_base)
    prune_ancestors_to_home(user_base.parent)
PY
    then
        echo "warning: could not remove recorded Python user-site dependencies" >&2
    fi
}

uninstall() {
    yes=false
    keep_data=false
    dry_run=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yes) yes=true; shift ;;
            --keep-data) keep_data=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) echo "unknown uninstall option: $1" >&2; exit 2 ;;
        esac
    done

    if [ "$yes" != "true" ]; then
        echo "Refusing to uninstall without --yes." >&2
        exit 2
    fi
    if [ ! -f "$RECEIPT_PATH" ]; then
        echo "No install receipt found at $RECEIPT_PATH" >&2
        exit 1
    fi
    if [ "$dry_run" = "true" ]; then
        echo "Would remove OpenSolar files recorded under $SOLAR_HOME and $CLAUDE_DIR/solar"
        exit 0
    fi

    remove_sentinel
    remove_solar_settings
    remove_python_user_deps
    remove_daemons
    remove_mcp_servers
    remove_installed_skills
    if guard_path "$CLAUDE_DIR/solar"; then
        rm -rf "$CLAUDE_DIR/solar"
    fi
    rmdir "$CLAUDE_DIR" 2>/dev/null || true
    if [ "$keep_data" = "true" ]; then
        # --keep-data contract: preserve ONLY the user's data (db/ + identity/
        # + config.env + .env) and remove EVERYTHING else under SOLAR_HOME
        # (code, venv, bin, node_modules, cache, logs, receipt, registered-*.txt, ...). Enumerate
        # what to KEEP (not what to remove) so new derived artifacts can never
        # silently survive a --keep-data uninstall.
        if guard_path "$SOLAR_HOME" && [ -d "$SOLAR_HOME" ]; then
            find "$SOLAR_HOME" -mindepth 1 -maxdepth 1 \
                ! -name db ! -name identity ! -name config.env ! -name .env \
                -exec rm -rf {} +
        fi
    elif guard_path "$SOLAR_HOME"; then
        rm -rf "$SOLAR_HOME"
    fi
    echo "OpenSolar uninstalled"
}

components_list() {
    if [ -f "$RECEIPT_PATH" ]; then
        "$PYTHON_BIN" - "$RECEIPT_PATH" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as f:
    receipt = json.load(f)
for name in receipt.get("components", []):
    print(name)
PY
    fi
}

do_ui() {
    script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    helper=""
    for candidate in \
        "$SOLAR_HOME/harness/lib/cli/solar_ui_lite.py" \
        "$script_dir/../harness/lib/cli/solar_ui_lite.py"
    do
        if [ -f "$candidate" ]; then
            helper="$candidate"
            break
        fi
    done
    if [ -z "$helper" ]; then
        src=""
        if src="$(receipt_field source_dir 2>/dev/null)"; then
            if [ -f "$src/harness/lib/cli/solar_ui_lite.py" ]; then
                helper="$src/harness/lib/cli/solar_ui_lite.py"
            fi
        fi
    fi
    if [ -z "$helper" ]; then
        echo "Solar UI-lite helper not found; reinstall with harness or run from the source checkout." >&2
        exit 1
    fi
    [ -n "$PYTHON_BIN" ] || { echo "python3 is required for solar ui" >&2; exit 1; }
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" exec "$PYTHON_BIN" "$helper" "$@"
}

do_harness() {
    script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    helper=""
    harness_dir=""
    for candidate in \
        "$SOLAR_HOME/bin/solar-harness" \
        "$SOLAR_HOME/harness/solar-harness.sh" \
        "$script_dir/../harness/solar-harness.sh"
    do
        if [ -f "$candidate" ]; then
            helper="$candidate"
            case "$candidate" in
                "$SOLAR_HOME/bin/solar-harness"|"$SOLAR_HOME/harness/solar-harness.sh")
                    harness_dir="$SOLAR_HOME/harness"
                    ;;
                *)
                    harness_dir="$(CDPATH= cd -- "$(dirname -- "$candidate")" && pwd)"
                    ;;
            esac
            break
        fi
    done
    if [ -z "$helper" ]; then
        echo "solar harness backend not found; reinstall with the harness component." >&2
        exit 1
    fi
    if [ "$#" -eq 0 ]; then
        set -- help
    fi
    HARNESS_DIR="${HARNESS_DIR:-$harness_dir}" exec "$helper" "$@"
}

find_harness_lib_helper() {
    helper_name="$1"
    script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    helper=""
    for candidate in \
        "$SOLAR_HOME/harness/lib/$helper_name" \
        "$script_dir/../harness/lib/$helper_name"
    do
        if [ -f "$candidate" ]; then
            helper="$candidate"
            break
        fi
    done
    if [ -z "$helper" ]; then
        src=""
        if src="$(receipt_field source_dir 2>/dev/null)"; then
            if [ -f "$src/harness/lib/$helper_name" ]; then
                helper="$src/harness/lib/$helper_name"
            fi
        fi
    fi
    [ -n "$helper" ] || return 1
    printf '%s\n' "$helper"
}

run_harness_lib_helper() {
    helper_name="$1"
    shift
    helper="$(find_harness_lib_helper "$helper_name" || true)"
    if [ -z "$helper" ]; then
        echo "Solar helper not found: $helper_name; reinstall with harness or run from the source checkout." >&2
        exit 1
    fi
    command -v python3 >/dev/null 2>&1 || { echo "python3 is required for $helper_name" >&2; exit 1; }
    SOLAR_HOME="$SOLAR_HOME" CLAUDE_DIR="$CLAUDE_DIR" RECEIPT_PATH="$RECEIPT_PATH" exec python3 "$helper" "$@"
}

do_identity() {
    run_harness_lib_helper local_identity.py identity "$@"
}

do_privacy() {
    run_harness_lib_helper local_identity.py privacy "$@"
}

do_channel() {
    run_harness_lib_helper message_channel_adapters.py "$@"
}

cmd="${1:-}"
case "$cmd" in
    version) shift; do_version "$@" ;;
    status) shift; do_status "$@" ;;
    doctor) shift; doctor "$@" ;;
    update) shift; do_update "$@" ;;
    version-compare) shift; version_compare "${1:-}" "${2:-}" ;;
    repair) shift; do_repair "$@" ;;
    backup) shift; do_backup "$@" ;;
    restore) shift; do_restore "$@" ;;
    identity) shift; do_identity "$@" ;;
    privacy) shift; do_privacy "$@" ;;
    channel) shift; do_channel "$@" ;;
    ui) shift; do_ui "$@" ;;
    harness) shift; do_harness "$@" ;;
    uninstall) shift; uninstall "$@" ;;
    components)
        shift
        [ "${1:-}" = "list" ] || { usage; exit 2; }
        components_list
        ;;
    ""|--help|-h) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
