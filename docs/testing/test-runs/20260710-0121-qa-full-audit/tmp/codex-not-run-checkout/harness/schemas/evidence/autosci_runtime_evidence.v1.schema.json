{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/autosci_runtime_evidence.v1.schema.json",
  "title": "Solar Evidence ABI - AutoSci Runtime Evidence",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autosci_runtime_evidence.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": true,
      "properties": {
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["action", "status", "command_run", "exit_code", "evidence_ids", "checks"],
      "additionalProperties": true,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "init_sources",
            "discover_literature",
            "daily_arxiv_prepare_finalize",
            "run_experiment",
            "run_pilot_experiment",
            "build_poster",
            "compile_paper",
            "send_email",
            "visualize_graph",
            "setup_status",
            "reset_plan",
            "refine_artifact",
            "run_research_lifecycle"
          ]
        },
        "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
        "approval_ref": {"type": "string"},
        "command_run": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "outcome": {"type": "string", "enum": ["supports", "partially_supports", "refutes", "inconclusive", "failed"]},
        "result_collected": {"type": "boolean"},
        "browser_rendered": {"type": "boolean"},
        "png_exported": {"type": "boolean"},
        "overflow_probe": {"type": "string"},
        "pdf_generated": {"type": "boolean"},
        "pdf_path": {"type": "string"},
        "delivered": {"type": "boolean"},
        "provider": {"type": "string"},
        "runtime_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "check": {
      "type": "object",
      "required": ["check", "status", "detail"],
      "additionalProperties": true,
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["ok", "warn", "error"]},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "title", "source_channels", "ranking_score", "ranking_rationale", "dedup_status"],
      "additionalProperties": true,
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_channels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ranking_score": {"type": "number"},
        "ranking_rationale": {"type": "string", "minLength": 1},
        "dedup_status": {"type": "string", "enum": ["new", "known", "duplicate", "unknown"]},
        "fetch_status": {"type": "string", "enum": ["not_requested", "fetched", "failed", "skipped"]}
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": "string"}
      }
    }
  }
}
