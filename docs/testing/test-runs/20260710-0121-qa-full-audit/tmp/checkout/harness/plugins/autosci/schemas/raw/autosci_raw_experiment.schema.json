{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoSci Raw Experiment Fixture",
  "type": "object",
  "required": ["experiment_id", "outcome", "metrics"],
  "additionalProperties": true,
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string"},
    "outcome": {
      "type": "string",
      "enum": ["supports", "partially_supports", "refutes", "inconclusive", "failed"]
    },
    "metrics": {"type": "array"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
