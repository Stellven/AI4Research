{
  "$schema": "../schemas/task-graph.schema.json",
  "schema_version": "solar.task_graph.v1",
  "workflow_id": "scientific_claim_extraction_v1",
  "sprint_id": "scientific_claim_extraction_v1",
  "title": "Scientific Claim Extraction",
  "description": "Minimum Solar-native claim extraction template: ingest, extract, lightweight verification.",
  "dag_variant": "research",
  "research_mode": true,
  "version": 1,
  "architecture_guard": {
    "mode": "strict",
    "package_first": true,
    "forbidden_patterns": [
      "hidden-backend-full-workflow"
    ]
  },
  "evidence_policy": {
    "owner": "solar",
    "schemas_root": "schemas/evidence",
    "allow_failed": true,
    "allow_inconclusive": true,
    "require_task_sprint_node_provenance": true
  },
  "required_gates": [
    "G_PAPER_INGEST",
    "G_CLAIM_EXTRACT",
    "G_CLAIM_EXTRACTION_GATE"
  ],
  "nodes": [
    {
      "id": "paper_ingest",
      "goal": "Ingest supplied paper sources into Solar research paper evidence.",
      "logical_operator": "ScientificPaperIngestor",
      "depends_on": [],
      "required_capabilities": [
        "cap.research-paper-ingest",
        "research_synthesis",
        "data_extraction"
      ],
      "read_scope": [
        "dispatch/envelope.json"
      ],
      "write_scope": [
        "artifacts/scientific/scientific_claim_extraction_v1/paper_ingest/research_paper.v1.json"
      ],
      "gate": "G_PAPER_INGEST",
      "acceptance": [
        "Emits or validates research_paper.v1 evidence for ScientificPaperIngestor.",
        "Records failed or inconclusive status instead of inventing missing evidence.",
        "Does not call a hidden backend full workflow runner."
      ],
      "pass_conditions": [
        "research_paper.v1 payload is present or the node records failed/inconclusive evidence with limitations.",
        "Source evidence ids and provenance are preserved where applicable."
      ],
      "priority": 99,
      "required_phase": "research_taskgraph_template",
      "required_node_id": null,
      "required_node_status": null,
      "research_stage": "paper_ingestion",
      "evidence_policy": {
        "expected_schema": "research_paper.v1",
        "allow_failed": true,
        "allow_inconclusive": true,
        "require_provenance": true,
        "forbid_overclaiming": true
      },
      "architecture_policy": {
        "package_boundary": "plugins/autosci",
        "plugin_id": "autosci",
        "backend_contract": "single_bounded_action_or_solar_gate",
        "forbidden": [
          "hidden-backend-full-workflow",
          "backend-black-box-runner"
        ]
      },
      "status": "pending"
    },
    {
      "id": "claim_extract",
      "goal": "Extract source-grounded claims without verification.",
      "logical_operator": "ScientificClaimExtractor",
      "depends_on": [
        "paper_ingest"
      ],
      "required_capabilities": [
        "cap.research-claim-extract",
        "research_synthesis",
        "academic_critique"
      ],
      "read_scope": [
        "artifacts/scientific/scientific_claim_extraction_v1/paper_ingest/"
      ],
      "write_scope": [
        "artifacts/scientific/scientific_claim_extraction_v1/claim_extract/research_claims.v1.json"
      ],
      "gate": "G_CLAIM_EXTRACT",
      "acceptance": [
        "Emits or validates research_claims.v1 evidence for ScientificClaimExtractor.",
        "Records failed or inconclusive status instead of inventing missing evidence.",
        "Does not call a hidden backend full workflow runner."
      ],
      "pass_conditions": [
        "research_claims.v1 payload is present or the node records failed/inconclusive evidence with limitations.",
        "Source evidence ids and provenance are preserved where applicable."
      ],
      "priority": 98,
      "required_phase": "research_taskgraph_template",
      "required_node_id": "paper_ingest",
      "required_node_status": "passed",
      "research_stage": "claim_extraction",
      "evidence_policy": {
        "expected_schema": "research_claims.v1",
        "allow_failed": true,
        "allow_inconclusive": true,
        "require_provenance": true,
        "forbid_overclaiming": true
      },
      "architecture_policy": {
        "package_boundary": "plugins/autosci",
        "plugin_id": "autosci",
        "backend_contract": "single_bounded_action_or_solar_gate",
        "forbidden": [
          "hidden-backend-full-workflow",
          "backend-black-box-runner"
        ]
      },
      "status": "pending"
    },
    {
      "id": "claim_extraction_gate",
      "goal": "Run lightweight Solar verification on required evidence and guardrails.",
      "logical_operator": "VerifierLite",
      "depends_on": [
        "claim_extract"
      ],
      "required_capabilities": [
        "test_execution",
        "code_impl"
      ],
      "read_scope": [
        "artifacts/scientific/scientific_claim_extraction_v1/claim_extract/"
      ],
      "write_scope": [
        "artifacts/scientific/scientific_claim_extraction_v1/claim_extraction_gate/verification_gate.v1.json"
      ],
      "gate": "G_CLAIM_EXTRACTION_GATE",
      "acceptance": [
        "Validates research_claims.v1 evidence and confirms claims are extracted but not verified."
      ],
      "pass_conditions": [
        "verification_gate.v1 payload is present or the node records failed/inconclusive evidence with limitations.",
        "Source evidence ids and provenance are preserved where applicable."
      ],
      "priority": 97,
      "required_phase": "research_taskgraph_template",
      "required_node_id": "claim_extract",
      "required_node_status": "passed",
      "research_stage": "verification",
      "evidence_policy": {
        "expected_schema": "verification_gate.v1",
        "allow_failed": true,
        "allow_inconclusive": true,
        "require_provenance": true,
        "forbid_overclaiming": true
      },
      "architecture_policy": {
        "package_boundary": "evaluators/scientific",
        "plugin_id": null,
        "backend_contract": "single_bounded_action_or_solar_gate",
        "forbidden": [
          "hidden-backend-full-workflow",
          "backend-black-box-runner"
        ]
      },
      "status": "pending"
    }
  ],
  "manual_review_checklist": [
    "Every node has logical_operator, required_capabilities, read_scope, write_scope, gate, and acceptance.",
    "Dependencies are explicit and acyclic.",
    "No node calls a full backend black-box workflow.",
    "Experiment-running nodes require bounded mode or human approval."
  ]
}
