{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/autosci_skill_run.v1.schema.json",
  "title": "Solar Evidence ABI - AutoSci Skill Run",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autosci_skill_run.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {
      "type": "object",
      "required": ["skill", "run_id", "work_dir", "route_config", "binding_config"],
      "additionalProperties": true,
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "skill_args": {"type": "array", "items": {"type": "string"}},
        "paper_path": {"type": "string"},
        "topic": {"type": "string"},
        "target": {"type": "string"},
        "run_id": {"type": "string", "minLength": 1},
        "work_dir": {"type": "string", "minLength": 1},
        "route_config": {"type": "string", "minLength": 1},
        "binding_config": {"type": "string", "minLength": 1}
      }
    },
    "outputs": {
      "type": "object",
      "required": ["skill_run"],
      "additionalProperties": true,
      "properties": {
        "skill_run": {"$ref": "#/$defs/skill_run"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "skill_run": {
      "type": "object",
      "required": [
        "selected_skill",
        "autosci_command",
        "execution_status",
        "side_effect_policy",
        "action_count",
        "passed_count",
        "schema_only_count",
        "failed_count",
        "actions",
        "route"
      ],
      "additionalProperties": true,
      "properties": {
        "selected_skill": {"type": "string", "minLength": 1},
        "autosci_command": {"type": "string", "minLength": 1},
        "execution_status": {"type": "string", "enum": ["completed", "partial", "gated", "failed"]},
        "side_effect_policy": {"type": "string", "enum": ["none", "dry_run_only", "approval_required", "unavailable"]},
        "action_count": {"type": "integer", "minimum": 0},
        "passed_count": {"type": "integer", "minimum": 0},
        "schema_only_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action_result"}},
        "route": {"$ref": "#/$defs/route"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "solar_capability": {"type": "string"},
        "solar_logical_operator": {"type": "string"},
        "solar_backend_action": {"type": "string"},
        "coverage_status": {"type": "string"},
        "backend_mode": {"type": "string"},
        "evidence_schema": {"type": "string"},
        "physical_operator": {"type": "string"}
      }
    },
    "action_result": {
      "type": "object",
      "required": ["action", "status", "schema", "evidence_path", "gate_status", "evidence_ids"],
      "additionalProperties": true,
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["passed", "failed", "schema_only"]},
        "schema": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "gate_status": {"type": "string", "enum": ["passed", "failed", "schema_only", "not_available"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
