{
  "$schema": "../schemas/task-graph.schema.json",
  "schema_version": "solar.task_graph.v1",
  "workflow_id": "scientific_experiment_lifecycle_v1",
  "sprint_id": "scientific_experiment_lifecycle_v1",
  "title": "Scientific Experiment Lifecycle",
  "description": "Template for evidence-grounded experiment planning, approved execution, monitoring, and verdict production.",
  "dag_variant": "research",
  "research_mode": true,
  "version": 1,
  "architecture_guard": {
    "mode": "strict",
    "package_first": true,
    "forbidden_patterns": [
      "hidden-backend-full-workflow"
    ]
  },
  "evidence_policy": {
    "owner": "solar",
    "schemas_root": "schemas/evidence",
    "allow_failed": true,
    "allow_inconclusive": true,
    "require_task_sprint_node_provenance": true
  },
  "required_gates": [
    "G_IDEA_GENERATE",
    "G_IDEA_EVALUATE",
    "G_EXPERIMENT_DESIGN",
    "G_EXPERIMENT_APPROVAL_GATE",
    "G_EXPERIMENT_RUN",
    "G_EXPERIMENT_MONITOR",
    "G_CLAIM_VERIFY"
  ],
