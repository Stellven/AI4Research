      "id": "idea_generate",
      "goal": "Generate evidence-grounded research idea candidates.",
      "logical_operator": "ScientificIdeaGenerator",
      "depends_on": [],
      "required_capabilities": [
        "cap.research-idea-generate",
        "research_synthesis",
        "academic_critique"
      ],
      "read_scope": [
        "dispatch/envelope.json"
      ],
      "write_scope": [
        "artifacts/scientific/scientific_experiment_lifecycle_v1/idea_generate/idea_candidate.v1.json"
      ],
      "gate": "G_IDEA_GENERATE",
      "acceptance": [
        "Emits or validates idea_candidate.v1 evidence for ScientificIdeaGenerator.",
        "Records failed or inconclusive status instead of inventing missing evidence.",
        "Does not call a hidden backend full workflow runner."
      ],
      "pass_conditions": [
        "idea_candidate.v1 payload is present or the node records failed/inconclusive evidence with limitations.",
        "Source evidence ids and provenance are preserved where applicable."
      ],
      "priority": 99,
      "required_phase": "research_taskgraph_template",
      "required_node_id": null,
      "required_node_status": null,
      "research_stage": "idea_generation",
      "evidence_policy": {
        "expected_schema": "idea_candidate.v1",
        "allow_failed": true,
        "allow_inconclusive": true,
        "require_provenance": true,
        "forbid_overclaiming": true
      },
      "architecture_policy": {
        "package_boundary": "plugins/autosci",
        "plugin_id": "autosci",
        "backend_contract": "single_bounded_action_or_solar_gate",
        "forbidden": [
          "hidden-backend-full-workflow",
          "backend-black-box-runner"
        ]
      },
      "status": "pending"
    },
