#!/usr/bin/env bash
echo "ssh $*" >> "$CALLS_LOG"
cmd="$*"
if [[ "$cmd" == *" echo ok" ]]; then
  echo ok
  exit 0
fi
if [[ "$cmd" == *"shasum -a 256"* ]]; then
  remote="$(printf '%s
' "$cmd" | sed -n "s/.*shasum -a 256 '\([^']*\)'.*/\1/p")"
  base="$(basename "$remote")"
  cat "$SHA_DIR/$base.sha"
  echo "  $remote"
  exit 0
fi
echo ok
