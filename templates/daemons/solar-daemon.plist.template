<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.solar.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{SOLAR_DAEMON_BUN}}</string>
        <string>run</string>
        <string>{{SOLAR_HOME}}/core/daemon/server.ts</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>WorkingDirectory</key>
    <string>{{SOLAR_HOME}}</string>
    <key>StandardOutPath</key>
    <string>{{SOLAR_HOME}}/logs/daemon-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{SOLAR_HOME}}/logs/daemon-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{SOLAR_DAEMON_HOME}}</string>
        <key>SOLAR_HOME</key>
        <string>{{SOLAR_HOME}}</string>
        <key>SOLAR_DB_PATH</key>
        <string>{{SOLAR_HOME}}/db/solar.db</string>
        <key>BUN_INSTALL_CACHE_DIR</key>
        <string>{{SOLAR_HOME}}/cache/bun</string>
        <key>BUN_RUNTIME_TRANSPILER_CACHE_PATH</key>
        <string>{{SOLAR_HOME}}/cache/bun-runtime</string>
    </dict>
</dict>
</plist>
