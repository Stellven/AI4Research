[Unit]
Description=OpenSolar runtime daemon
After=default.target

[Service]
Type=simple
ExecStart={{SOLAR_DAEMON_BUN}} run {{SOLAR_HOME}}/core/daemon/server.ts start
WorkingDirectory={{SOLAR_HOME}}
Environment=HOME={{SOLAR_DAEMON_HOME}}
Environment=SOLAR_HOME={{SOLAR_HOME}}
Environment=SOLAR_DB_PATH={{SOLAR_HOME}}/db/solar.db
Restart=on-failure
RestartSec=5
StandardOutput=append:{{SOLAR_HOME}}/logs/daemon-stdout.log
StandardError=append:{{SOLAR_HOME}}/logs/daemon-stderr.log

[Install]
WantedBy=default.target
