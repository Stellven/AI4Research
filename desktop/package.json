{
  "name": "solar-desktop",
  "desktopName": "solar-desktop.desktop",
  "version": "1.0.0-rc.9",
  "private": true,
  "description": "Solar desktop app — native shell that spawns the status-server backend and renders the bundled dashboard frontend. One codebase for macOS + Windows + Linux.",
  "author": "OpenSolar",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "SOLAR_DESKTOP_SELFTEST=1 electron .",
    "test:accessibility": "node accessibility.test.js",
    "gate": "node verify.js",
    "build:renderer": "node build-renderer.js",
    "prepackage-check": "node prepackage-check.js",
    "build:win": "node build-renderer.js && node prepackage-check.js && node prepare-package-resources.js && electron-builder --win portable",
    "build:mac": "node build-renderer.js && node prepackage-check.js && node prepare-package-resources.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "build:linux": "node build-renderer.js && node prepackage-check.js && node prepare-package-resources.js && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "dev.opensolar.desktop",
    "productName": "Solar",
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".packaging/harness",
        "to": "harness",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../VERSION",
        "to": "VERSION"
      },
      {
        "from": "../scripts/sync-harness-runtime.sh",
        "to": "sync-harness-runtime.sh"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../install.ps1",
          "to": "install.ps1"
        },
        {
          "from": "../get-solar.sh",
          "to": "get-solar.sh"
        },
        {
          "from": "runtime/install-windows-autostart.ps1",
          "to": "runtime/install-windows-autostart.ps1"
        },
        {
          "from": "runtime/start-solar-wsl.vbs",
          "to": "runtime/start-solar-wsl.vbs"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "../get-solar.sh",
          "to": "get-solar.sh"
        },
        {
          "from": "runtime/install-macos-agent.sh",
          "to": "runtime/install-macos-agent.sh"
        },
        {
          "from": "runtime/uninstall-macos-agent.sh",
          "to": "runtime/uninstall-macos-agent.sh"
        },
        {
          "from": "runtime/com.solar.status-server.plist",
          "to": "runtime/com.solar.status-server.plist"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "../get-solar.sh",
          "to": "get-solar.sh"
        }
      ]
    }
  }
}
