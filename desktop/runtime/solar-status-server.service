[Unit]
# Solar status-server (dashboard + API) as a per-user background service.
# Used on Linux and inside WSL2 (the Windows runtime host). Pairs with the
# desktop app's detect-or-start: the app attaches if this has the server healthy.
Description=Solar status-server (dashboard + API)
After=default.target

[Service]
Type=simple
Environment=HARNESS_DIR=%h/.solar/harness
Environment=PYTHONPATH=%h/.solar/harness/lib
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h/.solar/harness
# __PYTHON_BIN__ is rendered to the resolved python3 by install-linux-service.sh (systemd has no
# PATH, so this needs an absolute interpreter — /usr/bin/python3 isn't guaranteed under WSL/distros).
ExecStart=__PYTHON_BIN__ %h/.solar/harness/lib/symphony/status-server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
