<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron + a bundled Python runtime, ad-hoc signed (identity "-") with Hardened Runtime
       OFF. These let the ad-hoc bundle run on Apple Silicon: JIT for V8, and library-validation
       off so the app can load/spawn the bundled (differently-signed) Python and helpers. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
