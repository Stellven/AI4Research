{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensolar.local/schemas/runtime-deliverable-v1.json",
  "title": "OpenSolar Runtime Deliverable",
  "type": "object",
  "required": [
    "schema_version",
    "schema_path",
    "product",
    "target",
    "source",
    "assets",
    "configuration",
    "replay",
    "lifecycle",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "opensolar.runtime-deliverable/v1"},
    "schema_path": {"const": "runtime-deliverable.schema.json"},
    "product": {
      "type": "object",
      "required": ["name", "version", "entrypoint"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["kind", "operating_system", "architecture", "python", "python_requires"],
      "properties": {
        "kind": {"const": "python-wheel-runtime-bundle"},
        "operating_system": {"const": "linux"},
        "architecture": {"const": "x86_64"},
        "python": {"const": "CPython 3.12"},
        "python_requires": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["git_commit", "archive_path", "archive_format", "tree_sha256", "object_proof_path", "object_proof_sha256", "included_paths"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_path": {"type": "string", "minLength": 1},
        "archive_format": {"const": "git-archive-zip"},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "object_proof_path": {"type": "string", "minLength": 1},
        "object_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "included_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["path", "kind", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "embedded_credentials",
        "network_required_for_replay",
        "external_checkout_required_for_replay",
        "environment_injection_required_for_replay"
      ],
      "properties": {
        "embedded_credentials": {"const": false},
        "network_required_for_replay": {"const": false},
        "external_checkout_required_for_replay": {"const": false},
        "environment_injection_required_for_replay": {"const": false}
      },
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "required": [
        "script",
        "command",
        "required_host_tools",
        "required_host_python",
        "offline_dependency_directory",
        "bundled_jq",
        "smoke_evidence"
      ],
      "properties": {
        "script": {"const": "replay.sh"},
        "command": {"type": "string", "minLength": 1},
        "required_host_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_host_python": {"type": "string", "minLength": 1},
        "offline_dependency_directory": {"type": "string", "minLength": 1},
        "bundled_jq": {"type": "string", "minLength": 1},
        "smoke_evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["clean_install", "start_health", "rollback"],
      "properties": {
        "clean_install": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "start_health": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
