{
  "id": "s5-basic",
  "description": "S5 evolution loop gate: plugin framework, capability registry, and Mirage contract must pass before promotion.",
  "checks": [
    {
      "name": "plugin manifests validate",
      "cmd": "python3 lib/plugin_loader.py validate --json >/tmp/solar-s5-plugin-validation.json",
      "expect_exit": 0,
      "timeout_s": 60
    },
    {
      "name": "extension framework modules compile",
      "cmd": "python3 -m py_compile lib/plugin_loader.py lib/capability_registry.py lib/solar_mirage.py",
      "expect_exit": 0,
      "timeout_s": 15
    }
  ]
}
