{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.training_result.v1",
  "title": "OpenSolar Training Result",
  "type": "object",
  "required": ["schema_version", "job_id", "method", "status", "metrics", "evidence", "provenance", "artifacts", "promotion"],
  "properties": {
    "schema_version": {"const": "solar.training_result.v1"},
    "job_id": {"type": "string", "minLength": 1},
    "method": {"enum": ["sft", "lora", "dpo", "grpo", "agent_rl"]},
    "status": {"const": "passed"},
    "metrics": {
      "type": "object",
      "required": ["completed_steps", "planned_steps", "eval_score"],
      "properties": {
        "completed_steps": {"type": "integer", "minimum": 1},
        "planned_steps": {"type": "integer", "minimum": 1},
        "eval_score": {"type": "number"}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["parameter_update"],
      "properties": {
        "parameter_update": {"const": true}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "dataset_hash",
        "config_hash",
        "code_hash",
        "initial_weights_hash",
        "result_weights_hash",
        "checkpoint_hash"
      ],
      "additionalProperties": {"type": "string"}
    },
    "artifacts": {
      "type": "object",
      "required": ["checkpoint", "result"],
      "additionalProperties": {"type": "string"}
    },
    "promotion": {
      "type": "object",
      "required": ["controlled_by_evaluation_gate", "metric", "minimum", "actual", "passed"],
      "properties": {
        "controlled_by_evaluation_gate": {"const": true},
        "metric": {"type": "string"},
        "minimum": {"type": "number"},
        "actual": {"type": "number"},
        "passed": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": false
}
