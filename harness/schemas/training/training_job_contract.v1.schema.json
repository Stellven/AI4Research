{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.training_job_contract.v1",
  "title": "OpenSolar Training Job Contract",
  "type": "object",
  "required": ["job_id", "method", "dataset", "config", "initial_weights", "promotion_gate"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "method": {"enum": ["sft", "lora", "dpo", "grpo", "agent_rl"]},
    "dataset": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "config": {"type": "object"},
    "initial_weights": {"type": "object"},
    "resume_from": {"type": "string"},
    "promotion_gate": {
      "type": "object",
      "required": ["metric", "min"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "min": {"type": "number"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"const": "sft"}}},
      "then": {
        "properties": {
          "dataset": {
            "items": {"required": ["features", "label"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"method": {"const": "lora"}}},
      "then": {
        "properties": {
          "dataset": {
            "items": {"required": ["features", "target"]}
          },
          "config": {
            "properties": {"rank": {"type": "integer", "minimum": 1}}
          }
        }
      }
    },
    {
      "if": {"properties": {"method": {"const": "dpo"}}},
      "then": {
        "properties": {
          "dataset": {
            "items": {"required": ["chosen_features", "rejected_features"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"method": {"const": "grpo"}}},
      "then": {
        "properties": {
          "dataset": {
            "items": {"required": ["group_id", "features", "reward"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"method": {"const": "agent_rl"}}},
      "then": {
        "properties": {
          "dataset": {
            "items": {"required": ["state", "good_action", "bad_action"]}
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
