{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.requirement_semantics.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "assumptions",
    "discovery"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "origin",
          "statement",
          "priority",
          "source_refs",
          "acceptance",
          "check",
          "checkable",
          "disposition",
          "semantic_role"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "may"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "required_values"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "artifact_fields",
                  "scope_coverage",
                  "process",
                  "delivery",
                  "constraint"
                ]
              },
              "required_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "checkable": {
            "type": "boolean",
            "const": true
          },
          "disposition": {
            "type": "null"
          },
          "semantic_role": {
            "enum": [
              "research_scope",
              "process",
              "delivery",
              "outcome",
              "resolution",
              "constraint"
            ]
          }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "statement"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "discovery": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_id",
            "subject",
            "search_queries",
            "source_refs",
            "inclusion_criteria",
            "exclusion_criteria",
            "coverage",
            "time_range",
            "minimum_candidates"
          ],
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "search_queries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 8
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "inclusion_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "any_of",
                  "source_refs"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "title_abstract",
                      "publication_type"
                    ]
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "exclusion_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "any_of",
                  "source_refs"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "title_abstract",
                      "publication_type"
                    ]
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "any_of",
                  "required"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_year",
                "end_year"
              ],
              "properties": {
                "start_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1000,
                  "maximum": 9999
                },
                "end_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1000,
                  "maximum": 9999
                }
              }
            },
            "minimum_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
