{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.requirement_semantics.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "assumptions",
    "discovery",
    "selection_authority",
    "delivery_manifest"
  ],
  "properties": {
    "delivery_manifest": {
      "description": "Table-like contract for an explicit user-requested file set. Null when the user did not name file deliverables. This describes future output and does not claim that files already exist.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["output_root", "exact_file_set", "files"],
          "properties": {
            "output_root": {
              "type": "string",
              "minLength": 1,
              "description": "Exact user-requested output directory, represented as a safe relative path."
            },
            "exact_file_set": {
              "type": "boolean",
              "const": true,
              "description": "The producer must emit every listed required file and no undeclared deliverable file."
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file_id",
                  "relative_path",
                  "media_type",
                  "description",
                  "content_requirements",
                  "required_fields",
                  "source_refs",
                  "required"
                ],
                "properties": {
                  "file_id": {"type": "string", "minLength": 1},
                  "relative_path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact safe path beneath output_root. Preserve user-specified filenames and extensions."
                  },
                  "media_type": {
                    "enum": [
                      "text/markdown",
                      "text/csv",
                      "application/json",
                      "text/html",
                      "text/plain"
                    ]
                  },
                  "description": {"type": "string", "minLength": 1},
                  "content_requirements": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required_fields": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "description": "Exact machine-checkable CSV columns or JSON field names explicitly requested by the user; otherwise empty."
                  },
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required": {"type": "boolean", "const": true}
                }
              }
            }
          }
        },
        {"type": "null"}
      ]
    },
    "selection_authority": {
      "type": "array",
      "description": "Explicit user authority for each hard retrieval restriction; empty when retrieval uses topic queries and best-effort coverage only. Report topic coverage is not source-selection authority.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_path", "basis", "source_refs", "justification"],
        "properties": {
          "field_path": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "const": "explicit_source_selection"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "justification": {"type": "string", "minLength": 1}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "origin",
          "statement",
          "priority",
          "source_refs",
          "acceptance",
          "check",
          "checkable",
          "disposition",
          "semantic_role"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "may"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "required_values"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "artifact_fields",
                  "scope_coverage",
                  "process",
                  "delivery",
                  "constraint"
                ]
              },
              "required_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "checkable": {
            "type": "boolean",
            "const": true
          },
          "disposition": {
            "type": "null"
          },
          "semantic_role": {
            "enum": [
              "research_scope",
              "process",
              "delivery",
              "outcome",
              "resolution",
              "constraint"
            ]
          }
        }
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "statement"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "discovery": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_id",
            "subject",
            "search_queries",
            "source_refs",
            "inclusion_criteria",
            "exclusion_criteria",
            "coverage",
            "time_range",
            "minimum_candidates"
          ],
          "properties": {
            "contract_id": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "search_queries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 8
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "inclusion_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "any_of",
                  "source_refs"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "title_abstract",
                      "publication_type"
                    ]
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "exclusion_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "any_of",
                  "source_refs"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "title_abstract",
                      "publication_type"
                    ]
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "any_of",
                  "required"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "any_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_year",
                "end_year"
              ],
              "properties": {
                "start_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1000,
                  "maximum": 9999
                },
                "end_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1000,
                  "maximum": 9999
                }
              }
            },
            "minimum_candidates": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
