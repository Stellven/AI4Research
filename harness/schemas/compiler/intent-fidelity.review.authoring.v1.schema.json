{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/intent-fidelity.review.authoring.v1.schema.json",
  "title": "Independent IntentIR semantic review authoring body with deterministic source evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks", "decisions", "errors", "warnings"],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status"],
        "properties": {
          "kind": {
            "enum": [
              "goals_supported_by_source",
              "outcomes_supported_by_source",
              "constraints_supported_by_source",
              "no_material_omissions",
              "no_unrequested_execution",
              "ambiguity_unknown_classification"
            ]
          },
          "status": {"enum": ["pass", "warning", "fail"]}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer", "basis"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
  },
  "$defs": {
    "source_spans": {
      "description": "Provider-authored coordinates are advisory and replaced deterministically from source_quotes.",
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 0},
          {"type": "integer", "minimum": 1}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "source_quotes": {
      "description": "Exact verbatim substrings of raw.text, each long enough to occur exactly once.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "path", "message", "source_spans", "source_quotes", "repairable", "required_change"
      ],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "source_spans": {"$ref": "#/$defs/source_spans"},
        "source_quotes": {"$ref": "#/$defs/source_quotes"},
        "repairable": {"type": "boolean"},
        "required_change": {"type": "string", "minLength": 1}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message", "source_spans", "source_quotes"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "source_spans": {"$ref": "#/$defs/source_spans"},
        "source_quotes": {"$ref": "#/$defs/source_quotes"}
      }
    }
  }
}
