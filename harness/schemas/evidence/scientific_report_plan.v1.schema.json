{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/scientific_report_plan.v1.schema.json",
  "title": "Solar Evidence ABI - Scientific Report Plan",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "scientific_report_plan.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["report_plan"],
      "additionalProperties": false,
      "properties": {
        "report_plan": {
          "type": "object",
          "required": ["report_id", "title", "audience", "sections", "supported_claim_ids", "excluded_claim_ids", "evidence_ids"],
          "additionalProperties": false,
          "properties": {
            "report_id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "audience": {"type": "string", "minLength": 1},
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["section_id", "title", "purpose", "evidence_ids"],
                "additionalProperties": false,
                "properties": {
                  "section_id": {"type": "string", "minLength": 1},
                  "title": {"type": "string", "minLength": 1},
                  "purpose": {"type": "string", "minLength": 1},
                  "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
                }
              }
            },
            "supported_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "excluded_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "artifacts": {"type": "array"},
    "provenance": {
      "type": "object",
      "required": ["operator_id", "operator_version", "implementation_package", "timestamp", "input_sha256", "output_sha256"],
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
