{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_evidence_import.v1.schema.json",
  "title": "Research Evidence Import",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "outputs", "provenance", "limitations"],
  "properties": {
    "schema": {"const": "research_evidence_import.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"const": "evidence_import"},
    "status": {"enum": ["completed", "failed", "inconclusive"]},
    "outputs": {
      "type": "object",
      "required": ["imported_evidence", "imported_count"],
      "properties": {
        "imported_count": {"type": "integer", "minimum": 1},
        "imported_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "path", "sha256", "provenance"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "provenance": {"type": "object"}
            }
          }
        }
      }
    },
    "provenance": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
