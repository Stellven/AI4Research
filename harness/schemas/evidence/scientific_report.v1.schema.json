{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/scientific_report.v1.schema.json",
  "title": "Solar Evidence ABI - Scientific Report",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "scientific_report.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["report"],
      "additionalProperties": true,
      "properties": {
        "report": {"$ref": "#/$defs/report"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "report": {
      "type": "object",
      "required": ["report_id", "title", "sections", "evidence_ids", "unsupported_claims"],
      "additionalProperties": true,
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section_id", "title", "evidence_ids"],
            "additionalProperties": true,
            "properties": {
              "section_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unsupported_claims": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
