{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/publication_bundle.v1.schema.json",
  "title": "Solar Evidence ABI - Publication Bundle",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "publication_bundle.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["bundle"],
      "additionalProperties": true,
      "properties": {
        "bundle": {"$ref": "#/$defs/bundle"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "manifest_relative_path": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "bundle": {
      "type": "object",
      "required": ["bundle_id", "publication_type", "files", "source_report_id", "evidence_ids"],
      "additionalProperties": true,
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "publication_type": {"type": "string", "enum": ["paper", "poster", "rebuttal", "slides", "supplement", "mixed"]},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "source_report_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "delivery_manifest": {
          "type": "object",
          "required": ["output_root", "exact_file_set", "files"],
          "additionalProperties": false,
          "properties": {
            "output_root": {"type": "string", "minLength": 1},
            "exact_file_set": {"type": "boolean", "const": true},
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["file_id", "relative_path", "media_type", "description", "content_requirements", "required_fields", "source_refs", "required"],
                "additionalProperties": false,
                "properties": {
                  "file_id": {"type": "string", "minLength": 1},
                  "relative_path": {"type": "string", "minLength": 1},
                  "media_type": {"enum": ["text/markdown", "text/csv", "application/json", "text/html", "text/plain"]},
                  "description": {"type": "string", "minLength": 1},
                  "content_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "required_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                  "required": {"type": "boolean", "const": true}
                }
              }
            }
          }
        },
        "delivery_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    }
  }
}
