{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/research_node_result.v1.schema.json",
  "title": "Research Node Result v1",
  "description": "Worker-to-Solar result contract for one bounded research node.",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "run_id",
    "workflow_id",
    "node_id",
    "status",
    "status_is_terminal",
    "output_artifacts",
    "evidence",
    "hashes",
    "model_provider_usage",
    "errors",
    "limitations",
    "secret_redaction_assertion"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "research_node_result.v1"},
    "task_id": {"$ref": "#/$defs/non_empty_string"},
    "run_id": {"$ref": "#/$defs/non_empty_string"},
    "workflow_id": {"$ref": "#/$defs/non_empty_string"},
    "node_id": {"$ref": "#/$defs/non_empty_string"},
    "status": {"$ref": "#/$defs/node_status"},
    "status_is_terminal": {"type": "boolean"},
    "output_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "hashes": {
      "type": "array",
      "items": {"$ref": "#/$defs/hash_record"}
    },
    "model_provider_usage": {
      "type": "array",
      "items": {"$ref": "#/$defs/model_provider_usage"}
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/concise_error"}
    },
    "limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "secret_redaction_assertion": {"$ref": "#/$defs/secret_redaction_assertion"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["completed", "failed", "blocked", "cancelled"]}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {"status_is_terminal": {"const": true}}
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["pending", "ready", "running", "awaiting_human", "awaiting_external"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {"status_is_terminal": {"const": false}}
      }
    }
  ],
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "node_status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "awaiting_human",
        "awaiting_external",
        "completed",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "path"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"$ref": "#/$defs/non_empty_string"},
        "path": {"$ref": "#/$defs/non_empty_string"},
        "schema": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["evidence_id", "kind", "summary"],
      "additionalProperties": true,
      "properties": {
        "evidence_id": {"$ref": "#/$defs/non_empty_string"},
        "kind": {"$ref": "#/$defs/non_empty_string"},
        "summary": {"$ref": "#/$defs/non_empty_string"},
        "artifact_id": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "hash_record": {
      "type": "object",
      "required": ["hash_id", "algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "hash_id": {"$ref": "#/$defs/non_empty_string"},
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"}
      }
    },
    "model_provider_usage": {
      "type": "object",
      "required": ["provider", "model", "usage_kind"],
      "additionalProperties": true,
      "properties": {
        "provider": {"$ref": "#/$defs/non_empty_string"},
        "model": {"$ref": "#/$defs/non_empty_string"},
        "usage_kind": {"enum": ["none", "llm", "embedding", "tool", "provider_api"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_estimate_usd": {"type": "number", "minimum": 0}
      }
    },
    "concise_error": {
      "type": "object",
      "required": ["error_id", "error_type", "message"],
      "additionalProperties": false,
      "properties": {
        "error_id": {"$ref": "#/$defs/non_empty_string"},
        "error_type": {"$ref": "#/$defs/non_empty_string"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "secret_redaction_assertion": {
      "type": "object",
      "required": ["no_secrets_observed", "redaction_review"],
      "additionalProperties": false,
      "properties": {
        "no_secrets_observed": {"const": true},
        "redaction_review": {"enum": ["passed", "not_applicable"]}
      }
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
