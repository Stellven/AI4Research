{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/autosci_experiment_poc_handoff.v1.schema.json",
  "title": "AutoSci experiment POC handoff package",
  "type": "object",
  "required": [
    "schema",
    "status",
    "experiment_id",
    "summary",
    "production_entrypoints",
    "environment",
    "integration",
    "conformance",
    "provenance",
    "components",
    "component_hashes",
    "replay",
    "lease_recovery",
    "evidence_ids",
    "known_constraints"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autosci_experiment_poc_handoff.v1"},
    "status": {"const": "completed"},
    "experiment_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "production_entrypoints": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {
      "type": "object",
      "required": ["runtime", "python_version", "network_access", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "network_access": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "integration": {
      "type": "object",
      "required": ["approved_command", "executed_command", "approved_argv", "executed_argv", "exit_code", "result_collected"],
      "additionalProperties": false,
      "properties": {
        "approved_command": {"type": "string", "minLength": 1},
        "executed_command": {"type": "string", "minLength": 1},
        "approved_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "executed_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit_code": {"type": "integer"},
        "result_collected": {"const": true}
      }
    },
    "conformance": {
      "type": "object",
      "required": ["approval_contract_verified", "runtime_semantic_verified", "runtime_semantic_status"],
      "additionalProperties": false,
      "properties": {
        "approval_contract_verified": {"const": true},
        "runtime_semantic_verified": {"const": true},
        "runtime_semantic_status": {"const": "verified"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "implementation_package", "action", "created_at", "source_experiment_plan_sha256", "schema_validation"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "autosci_bridge._write_experiment_poc_handoff_package"},
        "implementation_package": {"const": "plugins/autosci"},
        "action": {"const": "run_experiment"},
        "created_at": {"type": "string", "format": "date-time"},
        "source_experiment_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_validation": {
          "type": "object",
          "required": ["schema", "validator", "status"],
          "additionalProperties": false,
          "properties": {
            "schema": {"const": "autosci_experiment_poc_handoff.v1"},
            "validator": {"const": "jsonschema.Draft202012Validator"},
            "status": {"const": "passed"}
          }
        }
      }
    },
    "components": {
      "type": "object",
      "required": ["experiment_plan", "runner", "dataset", "allowlist", "manifest", "expected_result", "runtime_evidence", "result", "lease_report"],
      "additionalProperties": false,
      "properties": {
        "experiment_plan": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "allowlist": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "runtime_evidence": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "lease_report": {"type": "string", "minLength": 1},
        "lease_recovery_audit": {"type": "string", "minLength": 1}
      }
    },
    "component_hashes": {
      "type": "object",
      "required": ["experiment_plan", "runner", "dataset", "allowlist", "manifest", "expected_result", "runtime_evidence", "result", "lease_report"],
      "additionalProperties": false,
      "properties": {
        "experiment_plan": {"$ref": "#/$defs/componentHash"},
        "runner": {"$ref": "#/$defs/componentHash"},
        "dataset": {"$ref": "#/$defs/componentHash"},
        "allowlist": {"$ref": "#/$defs/componentHash"},
        "manifest": {"$ref": "#/$defs/componentHash"},
        "expected_result": {"$ref": "#/$defs/componentHash"},
        "runtime_evidence": {"$ref": "#/$defs/componentHash"},
        "result": {"$ref": "#/$defs/componentHash"},
        "lease_report": {"$ref": "#/$defs/componentHash"},
        "lease_recovery_audit": {"$ref": "#/$defs/componentHash"}
      }
    },
    "replay": {
      "type": "object",
      "required": ["cwd", "argv", "expected_output", "expected_result_component", "network_access"],
      "additionalProperties": false,
      "properties": {
        "cwd": {"const": "."},
        "argv": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
        "expected_output": {"const": "replay/result.json"},
        "expected_result_component": {"const": "components/expected_result.json"},
        "network_access": {"const": "denied"}
      }
    },
    "lease_recovery": {
      "type": "object",
      "required": ["claimed", "experiment_id", "stale_observed", "recovered", "audit_recorded"],
      "additionalProperties": false,
      "properties": {
        "claimed": {"type": "boolean"},
        "experiment_id": {"type": "string", "minLength": 1},
        "stale_observed": {"type": "boolean"},
        "recovered": {"type": "boolean"},
        "audit_recorded": {"type": "boolean"}
      }
    },
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "known_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lease_recovery": {
            "properties": {"claimed": {"const": true}},
            "required": ["claimed"]
          }
        },
        "required": ["lease_recovery"]
      },
      "then": {
        "properties": {
          "components": {"required": ["lease_recovery_audit"]},
          "component_hashes": {"required": ["lease_recovery_audit"]},
          "lease_recovery": {
            "properties": {
              "stale_observed": {"const": true},
              "recovered": {"const": true},
              "audit_recorded": {"const": true}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "componentHash": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^components/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
