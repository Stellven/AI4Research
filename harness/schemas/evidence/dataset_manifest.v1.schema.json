{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/dataset_manifest.v1.schema.json",
  "title": "Solar Evidence ABI - Dataset and Experiment Asset Manifest",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "dataset_manifest.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["dataset_manifest"],
      "additionalProperties": false,
      "properties": {
        "dataset_manifest": {
          "type": "object",
          "required": ["experiment_family", "prepared_at", "dataset", "model", "assets", "execution", "criteria_bindings", "limitations"],
          "additionalProperties": false,
          "properties": {
            "experiment_family": {"type": "string", "minLength": 1},
            "prepared_at": {"type": "string", "format": "date-time"},
            "dataset": {
              "type": "object",
              "required": ["dataset_id", "config", "split", "fingerprint", "source", "record_count", "case_count", "context_lengths", "seeds", "evidence_id"],
              "additionalProperties": true
            },
            "model": {
              "type": "object",
              "required": ["model_id", "source", "parameter_count", "evidence_id"],
              "additionalProperties": true
            },
            "assets": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object",
                "required": ["role", "path", "sha256", "bytes"],
                "additionalProperties": false,
                "properties": {
                  "role": {"type": "string", "minLength": 1},
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "bytes": {"type": "integer", "minimum": 1}
                }
              }
            },
            "execution": {
              "type": "object",
              "required": ["contract", "command_argv", "result_path", "runner_sha256", "input_sha256s"],
              "additionalProperties": false,
              "properties": {
                "contract": {"const": "python_json_file.v1"},
                "command_argv": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 1}},
                "result_path": {"type": "string", "minLength": 1},
                "runner_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "input_sha256s": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
              }
            },
            "criteria_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object", "required": ["operator_id", "implementation_package", "timestamp"], "additionalProperties": true},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
