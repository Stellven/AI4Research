{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/scientific_report_plan_review.v1.schema.json",
  "title": "Solar Evidence ABI - Scientific Report Plan Review",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "scientific_report_plan_review.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["review", "findings", "artifact"],
      "additionalProperties": false,
      "properties": {
        "review": {
          "type": "object",
          "required": ["artifact_id", "target_schema", "review_stage", "review_mode", "review_available", "score", "recommendation", "evidence_ids", "reviewed_artifact_sha256"],
          "additionalProperties": true,
          "properties": {
            "artifact_id": {"type": "string", "minLength": 1},
            "target_schema": {"const": "scientific_report_plan.v1"},
            "review_stage": {"const": "pre_draft_plan"},
            "review_mode": {"const": "review_llm"},
            "review_available": {"const": true},
            "score": {"type": "number", "minimum": 0, "maximum": 1},
            "recommendation": {"type": "string", "enum": ["ready_with_findings", "revise_plan", "inconclusive"]},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "reviewed_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "severity", "category", "evidence", "suggestion"],
            "additionalProperties": true,
            "properties": {
              "finding_id": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
              "category": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1},
              "suggestion": {"type": "string", "minLength": 1}
            }
          }
        },
        "artifact": {
          "type": "object",
          "required": ["schema", "sha256"],
          "additionalProperties": true,
          "properties": {
            "schema": {"const": "scientific_report_plan.v1"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
