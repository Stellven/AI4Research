{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/idea_candidate.v1.schema.json",
  "title": "Solar Evidence ABI - Idea Candidate",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "idea_candidate.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["ideas"],
      "additionalProperties": true,
      "properties": {
        "ideas": {"type": "array", "items": {"$ref": "#/$defs/idea"}}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "idea": {
      "type": "object",
      "required": ["idea_id", "title", "hypothesis", "approach", "origin_evidence_ids"],
      "additionalProperties": true,
      "properties": {
        "idea_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "approach": {"type": "string", "minLength": 1},
        "origin_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "novelty_hypothesis": {"type": "string"}
      }
    }
  }
}
