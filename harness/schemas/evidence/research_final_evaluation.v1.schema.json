{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/research_final_evaluation.v1.schema.json",
  "title": "Solar Evidence ABI - Final Research Evaluation",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "research_final_evaluation.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"const": "final_evaluation"},
    "status": {"const": "completed"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["evaluation"],
      "additionalProperties": true,
      "properties": {
        "evaluation": {
          "type": "object",
          "required": ["decision", "accepted", "checks", "source_report_id", "publication_bundle_id", "evidence_ids", "does_not_modify_graph_or_run_state"],
          "additionalProperties": false,
          "properties": {
            "decision": {"const": "accepted"},
            "accepted": {"const": true},
            "checks": {
              "type": "object",
              "required": ["publication_bundle_present", "non_empty_report", "evidence_linked", "usable_file_manifest", "artifact_review_passed"],
              "additionalProperties": {"type": "boolean"}
            },
            "source_report_id": {"type": "string", "minLength": 1},
            "publication_bundle_id": {"type": "string", "minLength": 1},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "does_not_modify_graph_or_run_state": {"const": true}
          }
        }
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
