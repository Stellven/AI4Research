{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/workflow_evolution.v1.schema.json",
  "title": "Solar Evidence ABI - Workflow Evolution",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "workflow_evolution.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {"type": "object", "additionalProperties": true},
    "outputs": {
      "type": "object",
      "required": ["evolution"],
      "additionalProperties": true,
      "properties": {
        "evolution": {"$ref": "#/$defs/evolution"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "evolution": {
      "type": "object",
      "required": ["proposal_id", "scope", "change_type", "rationale", "expected_effect", "approval_state", "evidence_ids"],
      "additionalProperties": true,
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "change_type": {"type": "string", "enum": ["memory_policy", "workflow_template", "operator_prompt", "schema", "gate", "adapter", "other"]},
        "rationale": {"type": "string", "minLength": 1},
        "expected_effect": {"type": "string", "minLength": 1},
        "approval_state": {"type": "string", "enum": ["proposed", "approved", "rejected", "applied", "rolled_back"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "collected": {"$ref": "#/$defs/collected"},
        "proposed_changes": {"type": "array", "items": {"$ref": "#/$defs/proposed_change"}},
        "review": {"$ref": "#/$defs/review"},
        "recommended_changes_path": {"type": "string", "minLength": 1},
        "patch_candidates_path": {"type": "string", "minLength": 1}
      }
    },
    "collected": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failed_nodes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "gate_rejection_reasons": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "ambiguous_manuals_or_prompts": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "insufficient_schemas": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "poor_operator_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "human_intervention_points": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "runtime_errors": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      }
    },
    "proposed_change": {
      "type": "object",
      "required": ["change_id", "category", "target", "description", "evidence_ids", "review_required", "application_state"],
      "additionalProperties": true,
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["capsule", "manual", "routing", "gate", "schema", "workflow_template", "adapter", "other"]},
        "target": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "review_required": {"type": "boolean"},
        "application_state": {"type": "string", "enum": ["proposed_only", "not_applied", "applied"]}
      }
    },
    "review": {
      "type": "object",
      "required": ["human_accept_reject_required", "protected_core_edits_applied", "application_state"],
      "additionalProperties": true,
      "properties": {
        "human_accept_reject_required": {"type": "boolean"},
        "protected_core_edits_applied": {"type": "boolean"},
        "application_state": {"type": "string", "enum": ["proposed_only", "not_applied", "applied"]},
        "approval_ref": {"type": "string"}
      }
    }
  }
}
