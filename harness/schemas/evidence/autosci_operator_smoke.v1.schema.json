{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/evidence/autosci_operator_smoke.v1.schema.json",
  "title": "Solar Evidence ABI - AutoSci Operator Smoke",
  "type": "object",
  "required": ["schema", "task_id", "sprint_id", "node_id", "status", "inputs", "outputs", "artifacts", "provenance", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "autosci_operator_smoke.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "sprint_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "inputs": {
      "type": "object",
      "required": ["paper_path", "route_config", "binding_config"],
      "additionalProperties": true,
      "properties": {
        "paper_path": {"type": "string", "minLength": 1},
        "route_config": {"type": "string", "minLength": 1},
        "binding_config": {"type": "string", "minLength": 1},
        "work_dir": {"type": "string"}
      }
    },
    "outputs": {
      "type": "object",
      "required": ["smoke"],
      "additionalProperties": true,
      "properties": {
        "smoke": {"$ref": "#/$defs/smoke"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"type": "string", "enum": ["completed", "failed", "inconclusive"]},
    "artifact": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["operator_id", "implementation_package", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "implementation_package": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "smoke": {
      "type": "object",
      "required": [
        "paper_path",
        "route_count",
        "bound_count",
        "completed_count",
        "partial_count",
        "gated_count",
        "failed_count",
        "unbound_count",
        "core_action_count",
        "core_actions",
        "items"
      ],
      "additionalProperties": true,
      "properties": {
        "paper_path": {"type": "string", "minLength": 1},
        "route_count": {"type": "integer", "minimum": 0},
        "bound_count": {"type": "integer", "minimum": 0},
        "completed_count": {"type": "integer", "minimum": 0},
        "partial_count": {"type": "integer", "minimum": 0},
        "gated_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "unbound_count": {"type": "integer", "minimum": 0},
        "core_action_count": {"type": "integer", "minimum": 0},
        "core_actions": {"type": "array", "items": {"$ref": "#/$defs/core_action"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/smoke_item"}}
      }
    },
    "core_action": {
      "type": "object",
      "required": ["action", "status", "schema", "evidence_path", "gate_status", "evidence_ids"],
      "additionalProperties": true,
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["passed", "failed", "schema_only"]},
        "schema": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "gate_status": {"type": "string", "enum": ["passed", "failed", "schema_only", "not_available"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "smoke_item": {
      "type": "object",
      "required": [
        "native_skill",
        "autosci_feature",
        "solar_backend_action",
        "physical_operator",
        "side_effect_policy",
        "execution_status",
        "smoke_steps",
        "evidence_paths",
        "gate_statuses",
        "evidence_ids",
        "limitations"
      ],
      "additionalProperties": true,
      "properties": {
        "native_skill": {"type": "string", "minLength": 1},
        "autosci_feature": {"type": "string", "minLength": 1},
        "solar_backend_action": {"type": "string", "minLength": 1},
        "physical_operator": {"type": "string", "minLength": 1},
        "side_effect_policy": {"type": "string", "enum": ["none", "dry_run_only", "approval_required", "unavailable"]},
        "execution_status": {"type": "string", "enum": ["completed", "partial", "gated", "failed", "unbound"]},
        "smoke_steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "gate_statuses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
