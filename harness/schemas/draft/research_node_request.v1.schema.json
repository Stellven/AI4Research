{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/research_node_request.v1.schema.json",
  "title": "Research Node Request v1",
  "description": "Solar-to-worker dispatch contract for one bounded research node.",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "run_id",
    "workflow_id",
    "node_id",
    "logical_operator",
    "physical_operator",
    "typed_inputs",
    "input_artifact_refs",
    "authorization",
    "read_scope",
    "write_scope",
    "timeout_retry_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "research_node_request.v1"},
    "task_id": {"$ref": "#/$defs/non_empty_string"},
    "run_id": {"$ref": "#/$defs/non_empty_string"},
    "workflow_id": {"$ref": "#/$defs/non_empty_string"},
    "node_id": {"$ref": "#/$defs/non_empty_string"},
    "logical_operator": {
      "allOf": [
        {"$ref": "#/$defs/operator_ref"},
        {"properties": {"operator_kind": {"const": "logical"}}}
      ]
    },
    "physical_operator": {
      "allOf": [
        {"$ref": "#/$defs/operator_ref"},
        {"properties": {"operator_kind": {"const": "physical"}}}
      ]
    },
    "typed_inputs": {
      "type": "object",
      "required": ["input_schema", "payload"],
      "additionalProperties": false,
      "properties": {
        "input_schema": {"$ref": "#/$defs/non_empty_string"},
        "payload": {"type": "object", "additionalProperties": true}
      }
    },
    "input_artifact_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "authorization": {"$ref": "#/$defs/authorization"},
    "read_scope": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "write_scope": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "timeout_retry_policy": {"$ref": "#/$defs/timeout_retry_policy"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "operator_ref": {
      "type": "object",
      "required": ["operator_id", "operator_kind"],
      "additionalProperties": true,
      "properties": {
        "operator_id": {"$ref": "#/$defs/non_empty_string"},
        "operator_kind": {"enum": ["logical", "physical"]},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "path"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {"$ref": "#/$defs/non_empty_string"},
        "path": {"$ref": "#/$defs/non_empty_string"},
        "schema": {"$ref": "#/$defs/non_empty_string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "scope_id",
        "approved_capabilities",
        "allow_network",
        "allow_live_provider",
        "secret_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "scope_id": {"$ref": "#/$defs/non_empty_string"},
        "approved_capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "approval_ref": {"$ref": "#/$defs/non_empty_string"},
        "allow_network": {"type": "boolean"},
        "allow_live_provider": {"type": "boolean"},
        "secret_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_string"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"allow_live_provider": {"const": true}},
            "required": ["allow_live_provider"]
          },
          "then": {
            "required": ["approval_ref"],
            "properties": {"allow_network": {"const": true}}
          }
        }
      ]
    },
    "timeout_retry_policy": {
      "type": "object",
      "required": ["timeout_seconds", "max_attempts", "retry_on"],
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "retry_on": {
          "type": "array",
          "items": {"enum": ["transient_failure", "rate_limit", "provider_unavailable"]}
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  }
}
