{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.binding_trace.v2",
  "type": "object",
  "required": ["schema_version", "artifact_role", "binding_trace_id", "requirement_ir_ref", "plan_ir_ref", "bindings", "uncovered", "verdict"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "solar.binding_trace.v2"},
    "artifact_role": {"const": "runtime_artifact"},
    "binding_trace_id": {"type": "string", "minLength": 1},
    "requirement_ir_ref": {"type": "object"},
    "plan_ir_ref": {"type": "object"},
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["owners", "artifacts", "verifiers"],
        "additionalProperties": false,
        "properties": {
          "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "verifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "uncovered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verdict": {"enum": ["pass", "fail"]}
  }
}
