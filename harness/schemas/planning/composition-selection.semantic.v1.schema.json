{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.composition_selection.semantic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "selected_candidate_id", "rationale"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "selected_candidate_id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
