{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.plan_validation.v2",
  "type": "object",
  "required": ["schema_version", "artifact_role", "validation_id", "plan_ir_ref", "status", "checks", "errors", "warnings", "repair_count"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "solar.plan_validation.v2"},
    "artifact_role": {"const": "runtime_artifact"},
    "validation_id": {"type": "string", "minLength": 1},
    "plan_ir_ref": {
      "type": "object",
      "required": ["plan_ir_id", "generation", "sha256"],
      "additionalProperties": false,
      "properties": {
        "plan_ir_id": {"type": "string", "minLength": 1},
        "generation": {"type": "integer", "minimum": 0, "maximum": 4},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "kind", "status"],
        "additionalProperties": false,
        "properties": {
          "check_id": {"type": "string"},
          "kind": {"type": "string"},
          "status": {"enum": ["pass", "fail"]}
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "repair_count": {"type": "integer", "minimum": 0, "maximum": 4}
  }
}
