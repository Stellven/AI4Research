{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.planning_decision.semantic.v1",
  "type": "object",
  "required": ["decision", "rationale", "requirement_ids", "workflow_ref", "workflow_inputs", "workflow_bindings", "requirements_gap"],
  "additionalProperties": false,
  "properties": {
    "decision": {"enum": ["direct_response", "exact_reuse", "generate"]},
    "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "workflow_ref": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["workflow_id", "version"],
          "additionalProperties": false,
          "properties": {
            "workflow_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "workflow_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "stage_ids"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "stage_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "workflow_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "string"}
        }
      }
    },
    "requirements_gap": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["description", "source_refs"],
          "additionalProperties": false,
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  }
}
