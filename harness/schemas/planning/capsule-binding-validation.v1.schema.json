{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.capsule_binding_validation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "validation_id",
    "capsule_plan_ref",
    "status",
    "checks",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "solar.capsule_binding_validation.v1"},
    "artifact_role": {"const": "runtime_artifact"},
    "validation_id": {"type": "string", "minLength": 1},
    "capsule_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "stage_id", "status", "adapter_capsule_id", "target_artifacts"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "stage_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "adapter_capsule_id": {"type": "string", "minLength": 1},
          "target_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "node_id", "stage_id", "message", "target_artifacts"],
        "properties": {
          "code": {"const": "UNREGISTERED_ADAPTER_COERCION"},
          "node_id": {"type": "string", "minLength": 1},
          "stage_id": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "target_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
