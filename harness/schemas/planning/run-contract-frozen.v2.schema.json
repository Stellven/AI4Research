{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.run_contract.frozen.v2",
  "type": "object",
  "required": ["schema_version", "artifact_role", "sprint_id", "planning_authority", "requirement_ir_ref", "planning_decision_ref", "plan_ir_ref", "capsule_plan_ref", "physical_plan_ref", "evaluation_check_registry_ref", "evaluation_plan_ref", "evaluation_plan_validation_ref", "scheduler_input_ref", "plan_certificate", "contract_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "solar.run_contract.frozen.v2"},
    "artifact_role": {"const": "runtime_artifact"},
    "sprint_id": {"type": "string", "minLength": 1},
    "planning_authority": {"const": "frozen_execution_plan_v1"},
    "test_policy": {"type": "object", "additionalProperties": false, "properties": {"mode": {"const": "rapid_smoke"}, "semantic_evaluation_budget": {"const": 0}, "deterministic_gates_required": {"const": true}}},
    "requirement_ir_ref": {"type": "object"},
    "planning_decision_ref": {"type": "object"},
    "plan_ir_ref": {"type": "object"},
    "capsule_candidate_catalog_ref": {"type": ["object", "null"]},
    "capsule_selection_ref": {"type": ["object", "null"]},
    "capsule_selection_validation_ref": {"type": ["object", "null"]},
    "capsule_fit_review_ref": {"type": ["object", "null"]},
    "plan_composition_catalog_ref": {"type": ["object", "null"]},
    "composition_selection_ref": {"type": ["object", "null"]},
    "composition_selection_validation_ref": {"type": ["object", "null"]},
    "composition_fit_review_ref": {"type": ["object", "null"]},
    "artifact_type_registry_ref": {"type": ["object", "null"]},
    "artifact_conversion_registry_ref": {"type": ["object", "null"]},
    "capsule_plan_ref": {"type": "object"},
    "capsule_binding_validation_ref": {"type": "object"},
    "physical_plan_ref": {"type": "object"},
    "evaluation_check_registry_ref": {"type": "object"},
    "evaluation_plan_ref": {"type": "object"},
    "evaluation_plan_validation_ref": {"type": "object"},
    "scheduler_input_ref": {"type": "object", "required": ["scheduler_input_id", "sha256"], "properties": {"scheduler_input_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "plan_certificate": {"type": "object"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
