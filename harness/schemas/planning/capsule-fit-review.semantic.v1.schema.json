{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.capsule_fit_review.semantic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "errors", "warnings"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "status", "reason"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "node_id", "message", "repairable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "node_id": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "repairable": {"type": "boolean"}
      }
    }
  }
}
