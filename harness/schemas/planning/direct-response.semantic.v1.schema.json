{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.direct_response.semantic.v1",
  "type": "object",
  "required": ["answer", "requirement_ids", "limitations"],
  "additionalProperties": false,
  "properties": {
    "answer": {"type": "string", "minLength": 1},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
