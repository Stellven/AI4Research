{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.composition_candidate_search.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_role", "catalog_ref", "conversion_registry_ref",
    "available_inputs", "target_outputs", "target_satisfaction", "effect_policy", "execution_trust_policy",
    "bounds", "hyperedges", "excluded_capsules", "candidates", "unreachable_targets",
    "blocking_frontiers", "search_stats", "verdict"
  ],
  "properties": {
    "schema_version": {"const": "solar.composition_candidate_search.v1"},
    "artifact_role": {"const": "planner_candidate_artifact"},
    "catalog_ref": {"$ref": "#/$defs/ref"},
    "conversion_registry_ref": {"$ref": "#/$defs/ref"},
    "available_inputs": {"$ref": "#/$defs/string_set"},
    "target_outputs": {"$ref": "#/$defs/nonempty_string_set"},
    "target_satisfaction": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": {"enum": ["produced_by_composition", "existing_or_produced"]}
      }
    },
    "effect_policy": {
      "type": "object", "additionalProperties": false, "required": ["allowed_effects"],
      "properties": {"allowed_effects": {"$ref": "#/$defs/effects"}}
    },
    "execution_trust_policy": {
      "type": "object", "additionalProperties": false, "required": ["required_by_output"],
      "properties": {
        "required_by_output": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifact_type", "allowed_trust_classes"],
            "properties": {
              "artifact_type": {"type": "string", "minLength": 1},
              "allowed_trust_classes": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["measured_execution", "evidence_transform", "fixture_or_adapter_only", "unspecified"]}
              }
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["max_depth", "max_states", "max_candidates"],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_states": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "hyperedges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "excluded_capsules": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "unreachable_targets": {"$ref": "#/$defs/string_set"},
    "blocking_frontiers": {
      "type": "array", "maxItems": 20,
      "items": {"$ref": "#/$defs/blocking_frontier"}
    },
    "search_stats": {
      "type": "object", "additionalProperties": false,
      "required": ["explored_states", "visited_states", "relevant_edge_count", "bound_exhausted"],
      "properties": {
        "explored_states": {"type": "integer", "minimum": 0},
        "visited_states": {"type": "integer", "minimum": 0},
        "relevant_edge_count": {"type": "integer", "minimum": 0},
        "bound_exhausted": {"type": "boolean"}
      }
    },
    "verdict": {"enum": ["candidates_found", "unsatisfiable", "search_bound_exhausted"]}
  },
  "$defs": {
    "ref": {
      "type": "object", "required": ["sha256"], "additionalProperties": false,
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "string_set": {
      "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "nonempty_string_set": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}, "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {"enum": ["read", "write", "execute", "network"]},
      "uniqueItems": true
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "edge_kind", "capsule_id", "consumes", "produces", "effects"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "edge_kind": {"enum": ["capability_capsule", "approved_conversion"]},
        "capsule_id": {"type": "string", "minLength": 1},
        "consumes": {"$ref": "#/$defs/string_set"},
        "produces": {"$ref": "#/$defs/nonempty_string_set"},
        "effects": {"$ref": "#/$defs/effects"}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["capsule_id", "reason_codes"],
      "properties": {
        "capsule_id": {"type": "string", "minLength": 1},
        "reason_codes": {"$ref": "#/$defs/nonempty_string_set"},
        "disallowed_effects": {"$ref": "#/$defs/effects"},
        "trust_class": {"enum": ["measured_execution", "evidence_transform", "fixture_or_adapter_only", "unspecified"]},
        "trust_required_for": {"$ref": "#/$defs/nonempty_string_set"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "steps", "produced_types", "step_count", "aggregate_effects"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^composition-[0-9]{3}$"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "produced_types": {"$ref": "#/$defs/string_set"},
        "step_count": {"type": "integer", "minimum": 0},
        "aggregate_effects": {"$ref": "#/$defs/effects"}
      }
    },
    "blocking_frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "capsule_id", "produces", "missing_inputs"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "capsule_id": {"type": "string", "minLength": 1},
        "produces": {"$ref": "#/$defs/nonempty_string_set"},
        "missing_inputs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifact_type", "reason_code"],
            "properties": {
              "artifact_type": {"type": "string", "minLength": 1},
              "reason_code": {"enum": ["NO_ELIGIBLE_PRODUCER", "UPSTREAM_UNREACHABLE"]}
            }
          }
        }
      }
    }
  }
}
