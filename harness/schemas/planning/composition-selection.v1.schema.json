{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solar.composition_selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "selection_id",
    "generation",
    "requirement_ir_ref",
    "planning_context_ref",
    "plan_ir_ref",
    "composition_catalog_ref",
    "producer",
    "nodes"
  ],
  "properties": {
    "schema_version": {"const": "solar.composition_selection.v1"},
    "artifact_role": {"const": "planner_selection_artifact"},
    "selection_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0, "maximum": 1},
    "requirement_ir_ref": {"$ref": "#/$defs/ref"},
    "planning_context_ref": {"$ref": "#/$defs/ref"},
    "plan_ir_ref": {"$ref": "#/$defs/ref"},
    "composition_catalog_ref": {"$ref": "#/$defs/ref"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "provider", "model"],
      "properties": {
        "method": {"const": "model"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "selected_candidate_id",
          "step_bindings",
          "rationale",
          "requirement_ids",
          "admitted_candidate_ids"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "selected_candidate_id": {"type": "string", "minLength": 1},
          "step_bindings": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["edge_id", "capsule_id", "dispatch_task_type"],
              "properties": {
                "edge_id": {"type": "string", "minLength": 1},
                "capsule_id": {"type": "string", "minLength": 1},
                "dispatch_task_type": {"type": "string", "minLength": 1}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 5},
          "requirement_ids": {"$ref": "#/$defs/string_set"},
          "admitted_candidate_ids": {"$ref": "#/$defs/nonempty_string_set"}
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "string_set": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nonempty_string_set": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
