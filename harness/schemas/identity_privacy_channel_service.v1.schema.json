{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSolar local identity, privacy, and channel service contract",
  "type": "object",
  "required": ["repo_owned", "external_platforms"],
  "properties": {
    "repo_owned": {"type": "array", "items": {"enum": ["registration", "session", "profile", "credential_revocation", "privacy_lifecycle", "controlled_channel_adapter"]}},
    "external_platforms": {"type": "object", "properties": {"discord": {"const": "ENVIRONMENT_BLOCKED"}, "wechat": {"const": "ENVIRONMENT_BLOCKED"}}}
  }
}
