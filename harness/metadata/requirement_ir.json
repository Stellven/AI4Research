{
  "schema_version": "solar.requirement_ir.v2",
  "requirement_ir_id": "requirement-ir-20260825-091412-a3f8",
  "intent_ir_ref": {
    "intent_ir_id": "intent-ir-20260825-091412-a3f8",
    "sha256": "a9d4a3b707cc63cc6202cab28732bc98ee21ff2a94ab43e82bdcdcb22a8e9f1a"
  },
  "requirements": [
    {
      "requirement_id": "R1",
      "statement": "Produce a comparison covering satellite, airborne, and ground-based methane-leak measurement methods for oil and gas infrastructure.",
      "priority": "must",
      "source_refs": ["G1", "D1", "C1"],
      "acceptance": {
        "kind": "coverage",
        "required_values": ["satellite", "airborne", "ground_based"]
      },
      "required_evidence": ["method_inventory", "source_linked_comparison"],
      "verification": {"method": "semantic_evidence_review"}
    },
    {
      "requirement_id": "R2",
      "statement": "Assess sensitivity, false positives, weather limitations, coverage limitations, and validation conflicts for the compared methods.",
      "priority": "must",
      "source_refs": ["G1", "D1", "C2"],
      "acceptance": {
        "kind": "coverage",
        "required_values": [
          "sensitivity",
          "false_positives",
          "weather_limitations",
          "coverage_limitations",
          "validation_conflicts"
        ]
      },
      "required_evidence": ["dimension_definitions", "source_linked_findings"],
      "verification": {"method": "semantic_evidence_review"}
    },
    {
      "requirement_id": "R3",
      "statement": "Identify reported validation disagreements and preserve the evidence supporting each side.",
      "priority": "must",
      "source_refs": ["C2", "U1"],
      "acceptance": {
        "kind": "artifact_fields",
        "required_values": ["claim", "supporting_evidence", "conflicting_evidence"]
      },
      "required_evidence": ["contradiction_matrix", "source_quotations"],
      "verification": {"method": "contradiction_coverage_review"}
    },
    {
      "requirement_id": "R4",
      "statement": "Define and disclose the criteria used to select the most testable claims.",
      "priority": "must",
      "source_refs": ["G2", "C3", "U2"],
      "acceptance": {
        "kind": "artifact_fields",
        "required_values": ["selection_criteria", "selected_claims", "excluded_claims"]
      },
      "required_evidence": ["claim_testability_assessment", "selection_decision"],
      "verification": {"method": "selection_trace_review"}
    },
    {
      "requirement_id": "R5",
      "statement": "Produce a bounded reproducibility-check design for the selected claims without claiming that the experiment was executed.",
      "priority": "must",
      "source_refs": ["G2", "D2", "C3", "A1"],
      "acceptance": {
        "kind": "artifact_fields",
        "required_values": [
          "datasets",
          "metrics",
          "baselines",
          "resource_envelope",
          "stopping_conditions",
          "tested_vs_not_tested"
        ]
      },
      "required_evidence": ["reproducibility_check_design"],
      "verification": {"method": "experiment_design_review"}
    }
  ]
}
