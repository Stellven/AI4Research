      },
      "dashboard_label": "B6 · Claim verification (conditional)",
      "timeouts": {
        "result_timeout_sec": 300
      }
    },
    {
      "id": "final_delivery",
      "gate_family": "G_DELIVERY",
      "node_kind": "artifact",
      "logical_operator": "ScientificFinalDelivery",
      "depends_on": [
        "final_acceptance",
        "report_revision",
        "poc_handoff",
        "experiment_run",
        "claim_verification"
