      ],
      "task_type": "verification",
      "allowed_capsules": [
        "cap.research-experiment-approval"
      ],
      "allowed_operators": {
        "role": "builder",
        "providers": [
          "openai"
        ]
      },
      "outputs": [
        {
          "path": "artifacts/research_evidence_to_poc/poc/approval/",
          "type": "directory"
        },
        {
          "path": "artifacts/research_evidence_to_poc/poc/approval/experiment_approval.json",
          "type": "json"
        }
      ],
      "proof_obligations": [
        {
          "kind": "acceptance",
          "requirement": "human_approval_matches_exact_plan_generation_and_scope",
