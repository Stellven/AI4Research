      ],
      "task_type": "verification",
      "allowed_capsules": [
        "cap.research-external-experiment-run"
      ],
      "allowed_operators": {
        "role": "builder",
        "providers": [
          "openai"
        ]
      },
      "outputs": [
        {
          "path": "artifacts/research_evidence_to_poc/poc/run/",
