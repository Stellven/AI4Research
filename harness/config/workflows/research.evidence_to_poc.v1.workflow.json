        "role": "builder",
        "providers": [
          "openai"
        ]
      },
      "outputs": [
        {
          "path": "artifacts/research_evidence_to_poc/poc/design/",
          "type": "directory"
        },
        {
          "path": "artifacts/research_evidence_to_poc/poc/design/experiment_plan.json",
          "type": "json"
        }
      ],
      "proof_obligations": [
        {
          "kind": "acceptance",
          "requirement": "experiment_plan_is_bounded_and_hash_bound",
          "field": "artifacts/research_evidence_to_poc/poc/design/experiment_plan.json",
          "proof_kind": "artifact_presence"
        }
      ],
      "evaluator_gate": {
        "kind": "none",
        "on_fail": "fail"
      },
      "dashboard_label": "B3 · Bounded experiment design (conditional)",
      "timeouts": {
        "result_timeout_sec": 300
      }
    },
    {
      "id": "experiment_approval",
      "gate_family": "G_APPROVAL",
      "node_kind": "verify",
      "logical_operator": "ScientificExperimentApprovalValidator",
