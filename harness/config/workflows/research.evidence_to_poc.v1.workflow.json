      ],
      "task_type": "review",
      "allowed_capsules": [
        "cap.research-external-idea-evaluation"
      ],
      "allowed_operators": {
        "role": "builder",
        "providers": [
          "openai"
        ]
      },
      "outputs": [
        {
          "path": "artifacts/research_evidence_to_poc/poc/idea/",
          "type": "directory"
        },
        {
          "path": "artifacts/research_evidence_to_poc/poc/idea/idea_evaluation.json",
          "type": "json"
        }
      ],
      "proof_obligations": [
        {
          "kind": "acceptance",
          "requirement": "poc_idea_is_evidence_bound",
          "field": "artifacts/research_evidence_to_poc/poc/idea/idea_evaluation.json",
