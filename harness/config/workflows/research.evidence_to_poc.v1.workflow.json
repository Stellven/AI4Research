      "evaluator_gate": {
        "kind": "none",
        "on_fail": "fail"
      },
      "dashboard_label": "B4 · Exact-plan human approval (conditional)",
      "timeouts": {
        "result_timeout_sec": 300
      }
    },
    {
      "id": "experiment_run",
      "gate_family": "G_POC",
      "node_kind": "artifact",
      "logical_operator": "ScientificExperimentRunner",
      "depends_on": [
        "poc_handoff",
        "experiment_design",
