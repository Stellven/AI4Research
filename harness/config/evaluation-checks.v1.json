{
  "schema_version": "solar.evaluation_check_registry.v1",
  "artifact_role": "runtime_registry",
  "registry_id": "solar-evaluation-checks-v1",
  "checks": [
    {
      "check_id": "not_machine_checkable",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Require an independent reviewer and an explicit disclosure that this obligation was not machine-checked.",
      "deterministic": null,
      "semantic": {"rubric": ["Judge the obligation against the produced artifact and state the non-machine-checkable boundary explicitly."]}
    },
    {
      "check_id": "check.patch.v1",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review whether the produced patch implements the bound requirement without unrelated changes.",
      "deterministic": null,
      "semantic": {"rubric": ["The patch implements the bound requirement and does not introduce unrelated changes."]}
    },
    {
      "check_id": "check.tests.v1",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review the supplied test evidence for the bound requirement.",
      "deterministic": null,
      "semantic": {"rubric": ["The artifact contains attributable test evidence that exercises the bound requirement."]}
    },
    {
      "check_id": "check.review.v1",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Independently review the bound output against its requirement.",
      "deterministic": null,
      "semantic": {"rubric": ["The output satisfies the bound requirement and cites the evidence used for the verdict."]}
    },
    {
      "check_id": "check.patch_within_scope",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review whether the patch remains within the declared scope.",
      "deterministic": null,
      "semantic": {"rubric": ["Every changed path is necessary for the bound requirement and remains within the declared write scope."]}
    },
    {
      "check_id": "tests_executed_exit_0",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review attributable evidence that the declared tests executed successfully.",
      "deterministic": null,
      "semantic": {"rubric": ["The artifact records the exact test command, exit code zero, and result summary without relying on an unsupported claim."]}
    },
    {
      "check_id": "structured_output_parses",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review evidence that the declared structured output parsed successfully.",
      "deterministic": null,
      "semantic": {"rubric": ["The artifact identifies the parser or validator used and records a successful parse result."]}
    },
    {
      "check_id": "check.acceptance_evidence_recorded",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review whether acceptance evidence is concrete and attributable.",
      "deterministic": null,
      "semantic": {"rubric": ["Acceptance evidence names the checked artifacts, commands, results, and remaining limitations."]}
    },
    {
      "check_id": "check.coverage_reviewed",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Independently review whether every requirement owned by the node was evaluated against attributable output evidence.",
      "deterministic": null,
      "semantic": {"rubric": ["Every requirement owned by the node is explicitly evaluated against the produced artifacts, with gaps or unsupported coverage reported rather than passed."]}
    },
    {
      "check_id": "check.source_packs_verified",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review whether research sources are attributable and their validation boundary is disclosed.",
      "deterministic": null,
      "semantic": {"rubric": ["Source records are attributable, traceable, and do not claim scientific truth from metadata validation alone."]}
    },
    {
      "check_id": "check.grounded_report_bundle_written",
      "mode": "semantic",
      "applies_to": {"kind": "bound_output"},
      "decision": "Review whether the grounded report bundle answers the requirement with linked evidence.",
