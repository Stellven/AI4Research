      },
      "ambiguous_manuals_or_prompts": [
        {
          "manual_id": "scientific-experiment-run.dispatch",
          "description": "Retry guidance did not state whether failed fixture runs should regenerate the plan or only rerun execution."
        }
      ],
      "insufficient_schemas": [
        {
          "schema": "experiment_result.v1",
          "description": "The failed run did not make log artifact requirements obvious before gate time."
        }
      ],
      "poor_operator_bindings": [
        {
          "logical_operator": "ScientificExperimentRunner",
          "physical_operator": "autosci-experiment-worker",
          "description": "The binding accepted fixture execution without an explicit result-log preflight check."
        }
      ],
      "human_intervention_points": [
        {
          "point": "experiment_retry_decision",
          "description": "A human should approve whether to retry execution or revise the plan after repeated fixture failures."
        }
      ],
      "runtime_errors": [
        {
          "error_id": "runtime.missing-result-log",
          "message": "Expected experiment_run.log was not written."
        }
      ]
    }
  },
  "outputs": {
    "evidence_payload_path": "artifacts/scientific/smoke/workflow_evolution.json",
    "recommended_changes_path": "artifacts/scientific/smoke/recommended_changes.md",
    "patch_candidates_path": "artifacts/scientific/smoke/patch_candidates",
