{
  "task_id": "task-autosci-phase16-evolve-workflow",
  "sprint_id": "sprint-autosci-phase16",
  "node_id": "node-workflow-evolve",
  "mode": "fixture",
  "output_dir": "artifacts/scientific/smoke",
  "inputs": {
    "failed_run": {
      "workflow_id": "scientific_research_lifecycle_full_v1",
      "sprint_id": "sprint-autosci-phase16-failed-run",
      "nodes": [
        {
          "id": "experiment_run",
          "logical_operator": "ScientificExperimentRunner",
          "gate": "G_EXPERIMENT_RUN",
          "status": "failed"
        },
        {
          "id": "claim_verify",
          "logical_operator": "ScientificClaimVerifier",
          "gate": "G_CLAIM_VERIFY",
          "status": "blocked"
        }
      ],
      "gate_results": {
        "G_EXPERIMENT_RUN": {
          "status": "failed",
          "reasons": [
            "experiment_result.v1 missing non-empty metrics",
            "experiment_result.v1 missing logs artifact"
